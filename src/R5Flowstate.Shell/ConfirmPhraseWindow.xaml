<Window x:Class="R5Flowstate.Shell.ConfirmPhraseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:R5Flowstate.Shell"
        Title="{loc:T title_remove}"
        Icon="Assets/app.ico"
        SizeToContent="Height" Width="520"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBg}" Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <StackPanel Margin="24,22,24,20">
    <TextBlock x:Name="TxtHeadline" FontSize="19" FontWeight="SemiBold"
               Foreground="{StaticResource DangerFg}" TextWrapping="Wrap"/>
    <TextBlock x:Name="TxtDetail" Margin="0,10,0,0" FontSize="13"
               Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
    <Border Margin="0,14,0,0" CornerRadius="8" Padding="14,11"
            Background="{StaticResource SurfaceSunken}">
      <TextBlock x:Name="TxtTarget" FontFamily="Consolas" FontSize="12"
                 Foreground="{StaticResource TextCode}" TextWrapping="Wrap"/>
    </Border>
    <TextBlock x:Name="TxtPrompt" Margin="0,18,0,6" FontSize="13"
               Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
    <TextBox x:Name="TxtPhrase" Height="36" FontFamily="Consolas" FontSize="14"
             TextChanged="OnPhraseChanged"/>
    <DockPanel Margin="0,20,0,0" LastChildFill="False">
      <Button x:Name="BtnConfirm" DockPanel.Dock="Right" Content="{loc:T remove_game}"
              MinWidth="140" Height="36" IsEnabled="False" IsDefault="True"
              Style="{StaticResource DangerButtonSmall}" Click="OnConfirm"/>
      <Button x:Name="BtnCancel" DockPanel.Dock="Right" Content="{loc:T cancel_title}"
              Width="100" Height="36" Margin="0,0,10,0" IsCancel="True"
              Style="{StaticResource GhostButton}" Click="OnCancel"/>
    </DockPanel>
  </StackPanel>
</Window>

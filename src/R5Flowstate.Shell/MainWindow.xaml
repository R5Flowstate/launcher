            </Viewbox>
          </Button>
        </StackPanel>

        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,24,0">
          <Image Source="Assets/logo.png" Height="32" Margin="0,0,12,0"
                 VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                 Cursor="Hand" ToolTip="{loc:T tip_website}"
                 MouseLeftButtonUp="OnOpenWebsite"/>
          <TextBlock VerticalAlignment="Center" FontSize="20" FontWeight="Bold"
                     Text="R5Flowstate" Foreground="{DynamicResource TextPrimary}"/>
          <TextBlock Text="{loc:T badge_beta}" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,7"
                     VerticalAlignment="Center" Foreground="{DynamicResource AccentBright}"/>
        </StackPanel>

        <DockPanel LastChildFill="True">
          <Button x:Name="BtnTabScrollLeft" DockPanel.Dock="Left"
                  Style="{StaticResource GhostButton}"
                  Width="24" Height="30" Padding="0" Margin="0,0,2,0"
                  VerticalAlignment="Center" Visibility="Collapsed"
                  FontFamily="Segoe MDL2 Assets" FontSize="10"
                  Content="&#xE76B;" Click="OnTabScrollLeft"/>
          <Button x:Name="BtnTabScrollRight" DockPanel.Dock="Right"
                  Style="{StaticResource GhostButton}"
                  Width="24" Height="30" Padding="0" Margin="2,0,0,0"
                  VerticalAlignment="Center" Visibility="Collapsed"
                  FontFamily="Segoe MDL2 Assets" FontSize="10"
                  Content="&#xE76C;" Click="OnTabScrollRight"/>
          <ScrollViewer x:Name="TabScroll" HorizontalAlignment="Left"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled"
                        ScrollChanged="OnTabScrollChanged"
                        PreviewMouseWheel="OnTabScrollWheel">
            <Grid>
            <StackPanel x:Name="PanelNavTabs" Orientation="Horizontal">
              <Button x:Name="BtnTabLocal" Content="{loc:T nav_play}" Height="75" FontSize="15" BorderBrush="Transparent" Margin="0,0,20,0"
                      Style="{StaticResource TabButtonOn}" Click="OnSimpleTabLocal"/>
              <Button x:Name="BtnTabServers" Content="{loc:T nav_servers}" Height="75" FontSize="15" BorderBrush="Transparent" Margin="0,0,20,0"
                      Style="{StaticResource TabButton}" Click="OnSimpleTabServers"
                      ToolTip="{loc:T tip_servers_locked}"/>
              <Button x:Name="BtnTabLeaderboards" Content="{loc:T tab_leaderboards}" Height="75" FontSize="15" BorderBrush="Transparent" Margin="0,0,20,0"
                      Style="{StaticResource TabButton}" Click="OnSimpleTabLeaderboards"
                      ToolTip="{loc:T tip_leaderboards}"/>
              <Button x:Name="BtnTabReplays" Content="{loc:T tab_replays}" Height="75" FontSize="15" BorderBrush="Transparent" Margin="0,0,20,0"
                      Style="{StaticResource TabButton}" Click="OnSimpleTabReplays"
                      ToolTip="{loc:T tip_replays}"/>
              <Button x:Name="BtnTabMods" Content="{loc:T nav_mods}" Height="75" FontSize="15" BorderBrush="Transparent" Margin="0,0,20,0"
                      Style="{StaticResource TabButton}" Click="OnSimpleTabMods"/>
              <Button x:Name="BtnTabConsole" Content="{loc:T tab_console}" Height="75" FontSize="15" BorderBrush="Transparent" Margin="0,0,20,0"
                      Style="{StaticResource TabButton}" Click="OnSimpleTabConsole"/>
              <Button x:Name="BtnTabNews" Height="75" FontSize="15" BorderBrush="Transparent" Margin="0,0,20,0"
                      Style="{StaticResource TabButton}" Click="OnSimpleTabNews">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{loc:T nav_news}" VerticalAlignment="Center"/>
                  <Grid VerticalAlignment="Center">
                    <Ellipse x:Name="DotBlogUnread" Width="7" Height="7" Margin="6,0,0,1"
                             Fill="{DynamicResource Accent}" Visibility="Collapsed"/>
                    <Ellipse x:Name="DotNotesUnread" Width="7" Height="7" Margin="6,0,0,1"
                             Fill="{DynamicResource Accent}" Visibility="Collapsed"/>
                  </Grid>
                </StackPanel>
              </Button>
              <Button x:Name="BtnTabAdvanced" Content="{loc:T nav_advanced}" Height="75" FontSize="15" BorderBrush="Transparent" Margin="0"
                      Style="{StaticResource TabButton}" Click="OnSimpleTabAdvanced"/>
            </StackPanel>
            <Canvas IsHitTestVisible="False">
              <Border x:Name="NavIndicator" Height="3" CornerRadius="1.5" Canvas.Top="52" Width="0"
                      Background="{DynamicResource Accent}">
                <Border.RenderTransform>
                  <TranslateTransform x:Name="NavIndicatorShift"/>
                </Border.RenderTransform>
              </Border>
            </Canvas>
            </Grid>
          </ScrollViewer>
        </DockPanel>
      </DockPanel>
    </Border>

    <DockPanel Grid.Row="1">
    <Grid>
      <!-- Simple player shell -->
      <DockPanel x:Name="PanelSimple">
        <TextBlock x:Name="TxtBrowserStatus" DockPanel.Dock="Top" Text="" FontSize="12"
                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                   Background="{DynamicResource SurfaceBg}"
                   Padding="16,12,16,0" Visibility="Collapsed"/>
        <Border x:Name="BarSimpleFooter" DockPanel.Dock="Bottom" Margin="0"
                Padding="16,8" Background="{DynamicResource WindowBg}"
                BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                      Margin="16,0,0,0">
            <Button Style="{StaticResource FooterIcon}" Click="OnOpenWebsite" ToolTip="{loc:T tip_website}">
              <Viewbox Width="15" Height="15">
                <Canvas Width="16" Height="16">
                  <Ellipse Canvas.Left="0.8" Canvas.Top="0.8" Width="14.4" Height="14.4"
                           Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.4"/>
                  <Ellipse Canvas.Left="4.9" Canvas.Top="0.8" Width="6.2" Height="14.4"
                           Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.2"/>
                  <Line X1="1.2" Y1="8" X2="14.8" Y2="8"
                        Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.2"/>
                </Canvas>
              </Viewbox>
            </Button>
            <Button Style="{StaticResource FooterIcon}" Click="OnOpenDiscord" ToolTip="{loc:T tip_discord}">
              <Viewbox Width="15" Height="15">
                <Path Fill="{DynamicResource TextSecondary}" Stretch="Uniform"
                      Data="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028 14.09 14.09 0 001.226-1.994.076.076 0 00-.041-.106 13.107 13.107 0 01-1.872-.892.077.077 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.198.373.292a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.892.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
              </Viewbox>
            </Button>
            <Button Style="{StaticResource FooterIcon}" Click="OnOpenGitHub" ToolTip="{loc:T tip_github}">
              <Viewbox Width="15" Height="15">
                <Path Fill="{DynamicResource TextSecondary}" Stretch="Uniform"
                      Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
              </Viewbox>
            </Button>
            <TextBlock x:Name="TxtShellUpdateLink" Visibility="Collapsed"
                       Margin="10,0,0,0" FontSize="11.5" VerticalAlignment="Center">
              <Hyperlink Click="OnShellUpdateLinkClick"
                         ToolTip="{loc:T tip_update}">
                <Run x:Name="RunShellUpdateLink" Text="{loc:T update_available}"/>
              </Hyperlink>
            </TextBlock>
            <TextBlock x:Name="TxtSimpleVersion" Margin="8,0,0,0"
                       FontFamily="Consolas" FontSize="11.5"
                       Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
          </StackPanel>
          <Grid VerticalAlignment="Center" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="DotSimpleStatus" Grid.Column="0" Width="6" Height="6"
                     Margin="0,0,8,0" VerticalAlignment="Center"
                     Fill="{DynamicResource Accent}"/>
            <TextBlock x:Name="TxtSimpleStatus" Grid.Column="1" Text="{loc:T ready_to_play}"
                       FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextMuted}"
                       VerticalAlignment="Center"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"/>
          </Grid>
        </DockPanel>
        </Border>
        <Border x:Name="BarModQueueStrip" DockPanel.Dock="Bottom" Height="40" Padding="20,0"
                Background="{DynamicResource SurfaceSunken}" Visibility="Collapsed">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="{loc:T mods_q_details}" Style="{StaticResource TextButton}"
                    Margin="16,0,0,0" Click="OnModQueueStripDetails"/>
            <TextBlock x:Name="TxtQStripStats" DockPanel.Dock="Right" FontSize="12.5" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}"/>
            <TextBlock x:Name="TxtQStripName" DockPanel.Dock="Left" FontSize="13" Margin="0,0,16,0"
                       VerticalAlignment="Center" MaxWidth="320" TextTrimming="CharacterEllipsis"/>
            <ProgressBar x:Name="BarQStrip" Style="{StaticResource FlatBar}" Height="3" Margin="0,0,16,0"
                         VerticalAlignment="Center"/>
          </DockPanel>
        </Border>
        <Grid Background="{DynamicResource SurfaceBg}" ClipToBounds="True">
          <Image x:Name="ImgAmbientPrevious" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
          <Image x:Name="ImgAmbient" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
          <Grid x:Name="GridShellContent">
          <Grid.RenderTransform>
            <TranslateTransform x:Name="ShellContentShift"/>
          </Grid.RenderTransform>
          <DockPanel x:Name="PanelSimpleLocal">
            <ProgressBar x:Name="BarSimpleInstall" DockPanel.Dock="Bottom"
                         Height="6" Minimum="0" Maximum="100" Value="0"
                         Margin="0,10,0,0"
                         Visibility="Collapsed"/>
            <Grid>
              <Grid x:Name="PanelSimplePlay" Margin="14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="212"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Margin="0,0,12,0" CornerRadius="12" Padding="6"
                        Background="{DynamicResource GlassSurface}">
                  <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="2,2,2,6">
                      <TextBox x:Name="TxtPlaylistsSearch" Height="30" FontSize="12"
                               Padding="28,0,22,0" VerticalContentAlignment="Center"
                               ToolTip="{loc:T playlists_search}"
                               TextChanged="OnPlaylistsSearchChanged"/>
                      <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                 IsHitTestVisible="False" HorizontalAlignment="Left"
                                 Margin="8,0,0,0" VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextMuted}"/>
                      <TextBlock Text="{loc:T playlists_search}" IsHitTestVisible="False"
                                 FontSize="12" Margin="28,0,24,0" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource TextMuted}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Text, ElementName=TxtPlaylistsSearch}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <Button x:Name="BtnPlaylistsSearchClear"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Width="22" Height="22" Margin="0,0,3,0" Padding="0"
                              Style="{StaticResource CaptionButton}"
                              FontSize="9" Content="&#xE711;"
                              Visibility="Collapsed"
                              ToolTip="{loc:T clear}"
                              Click="OnPlaylistsSearchClear"/>
                    </Grid>
                    <TextBlock x:Name="TxtPlaylistsSearchEmpty" DockPanel.Dock="Top"
                               Text="{loc:T playlists_search_empty}"
                               FontSize="12" Margin="8,6,8,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMuted}"
                               Visibility="Collapsed"/>
                    <ScrollViewer x:Name="ScrollPlaylists"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ListModes" HorizontalAlignment="Stretch">
                      <ItemsControl.GroupStyle>
                        <GroupStyle>
                          <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                              <DockPanel Margin="2,9,2,5">
                                <TextBlock Text="{Binding Name}"
                                           Style="{StaticResource ModeRailGroup}"
                                           Margin="6,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ItemCount}"
                                           DockPanel.Dock="Right" Margin="8,0,6,0"
                                           FontFamily="Consolas" FontSize="10"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource BorderStrong}"/>
                                <Separator Background="{DynamicResource BorderSoft}"
                                           Height="1" Margin="0" VerticalAlignment="Center"/>
                              </DockPanel>
                            </DataTemplate>
                          </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                      </ItemsControl.GroupStyle>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button ToolTip="{Binding Blurb}"
                                  Tag="{Binding}"
                                  Style="{StaticResource ModeRailItem}"
                                  Click="OnModeChipClick">
                            <DockPanel LastChildFill="True">
                              <TextBlock Text="{Binding MapCountLabel}"
                                         DockPanel.Dock="Right" Margin="8,0,0,0"
                                         VerticalAlignment="Center"
                                         FontFamily="Consolas" FontSize="10">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                              <TextBlock Text="{Binding Title}"
                                         VerticalAlignment="Center"
                                         TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                  </DockPanel>
                </Border>
                <Grid Grid.Column="1">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Border Grid.Row="0" CornerRadius="12" ClipToBounds="True"
                          Background="{DynamicResource HeroBg}">
                    <Grid MinHeight="200" local:RoundedClip.Radius="12">
                      <Image x:Name="ImgLoadscreenPrevious"
                             Stretch="UniformToFill"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             RenderOptions.BitmapScalingMode="LowQuality"/>
                      <Image x:Name="ImgLoadscreen"
                             Stretch="UniformToFill"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             RenderTransformOrigin="0.5,0.5"
                             RenderOptions.BitmapScalingMode="LowQuality"/>
                      <Border VerticalAlignment="Bottom" Height="130" Background="{DynamicResource HeroShade}"/>
                      <StackPanel x:Name="PanelHeroText" VerticalAlignment="Bottom" Margin="22,0,170,18">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock x:Name="TxtHeroTitle" Text="{loc:T pick_a_map}"
                                     FontSize="30" FontWeight="SemiBold"
                                     Foreground="{DynamicResource HeroTitle}" TextTrimming="CharacterEllipsis"/>
                          <StackPanel Grid.Column="1" Margin="14,0,0,5" VerticalAlignment="Bottom">
                            <TextBlock x:Name="TxtHeroMap" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBright}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtHeroStem" FontFamily="Consolas" FontSize="11"
                                       Foreground="{DynamicResource HeroSubtitle}" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                        </Grid>
                        <TextBlock x:Name="TxtHeroSubtitle" Text=""
                                   FontSize="14" Foreground="{DynamicResource HeroSubtitle}"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom" Margin="0,0,12,12">
                        <Button x:Name="BtnMapPicker"
                                Height="36" Padding="13,0"
                                Style="{StaticResource GhostButton}"
                                Background="{DynamicResource HeroChip}"
                                Foreground="{DynamicResource TextPrimary}"
                                Visibility="Collapsed"
                                Click="OnToggleMapPicker"
                                ToolTip="{loc:T tip_pick_map_art}">
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="13" Height="13" Margin="0,0,8,0">
                              <Canvas Width="16" Height="16">
                                <Rectangle Canvas.Left="0" Canvas.Top="0" Width="7" Height="7" RadiusX="1.5" RadiusY="1.5"
                                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <Rectangle Canvas.Left="9" Canvas.Top="0" Width="7" Height="7" RadiusX="1.5" RadiusY="1.5"
                                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <Rectangle Canvas.Left="0" Canvas.Top="9" Width="7" Height="7" RadiusX="1.5" RadiusY="1.5"
                                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <Rectangle Canvas.Left="9" Canvas.Top="9" Width="7" Height="7" RadiusX="1.5" RadiusY="1.5"
                                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                              </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="TxtMapPickerLabel" FontSize="13" FontWeight="SemiBold"/>
                          </StackPanel>
                        </Button>
                      <Button x:Name="BtnReloadLoadscreen"
                              Margin="6,0,0,0"
                              Width="36" Height="36" Padding="0"
                              Style="{StaticResource GhostButton}"
                              Background="{DynamicResource HeroChip}"
                              BorderBrush="{DynamicResource HeroChipEdge}" BorderThickness="1"
                              Visibility="Collapsed"
                              Click="OnReloadLoadscreen"
                              ToolTip="{loc:T tip_shuffle_loadscreen}">
                        <Viewbox Width="15" Height="15">
                          <Canvas Width="16" Height="16">
                            <Path Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 14 8 A 6 6 0 1 1 12.2 3.8"/>
                            <Path Fill="{DynamicResource TextSecondary}"
                                  Data="M 15.2 1 L 15.2 5.2 L 11 5.2 Z"/>
                          </Canvas>
                        </Viewbox>
                      </Button>
                      </StackPanel>
                    </Grid>
                  </Border>

                  <Grid x:Name="BarMapStrip" Grid.Row="1" Margin="0,10,0,0"
                        Visibility="Collapsed" Background="Transparent"
                        PreviewMouseWheel="OnMapStripWheel">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
                      <Button x:Name="BtnMapPrev" Width="30" Padding="0" Margin="0,0,8,0" VerticalAlignment="Top"
                              Style="{StaticResource GhostButton}" Background="Transparent"
                              Foreground="{DynamicResource TextSecondary}"
                              FontFamily="Segoe MDL2 Assets" FontSize="13" Content="&#xE76B;"
                              AutomationProperties.Name="{loc:T map_previous}" Click="OnMapPrevious"/>
                      <Canvas x:Name="CanvasMapStrip" ClipToBounds="True" Margin="0,-10,0,-10">
                        <Border x:Name="StripGlow" CornerRadius="12" Opacity="0.6" IsHitTestVisible="False"
                                Background="{DynamicResource Accent}">
                          <Border.Effect>
                            <BlurEffect Radius="14"/>
                          </Border.Effect>
                        </Border>
                      </Canvas>
                      <Button x:Name="BtnMapNext" Width="30" Padding="0" Margin="8,0,0,0" VerticalAlignment="Top"
                              Style="{StaticResource GhostButton}" Background="Transparent"
                              Foreground="{DynamicResource TextSecondary}"
                              FontFamily="Segoe MDL2 Assets" FontSize="13" Content="&#xE76C;"
                              AutomationProperties.Name="{loc:T map_next}" Click="OnMapNext"/>
                    </StackPanel>
                  </Grid>

                  <Border x:Name="BarSimplePlay" Grid.Row="2" Margin="0,10,0,0" Height="64" Padding="10,0,8,0"
                          CornerRadius="12" Background="{DynamicResource GlassSurface}">
                    <DockPanel LastChildFill="True">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnChangeMap"
                                Style="{StaticResource GhostButton}"
                                Content="{loc:T change_map}"
                                MinWidth="128" Height="44" Padding="16,0"
                                Margin="0,0,10,0"
                                FontSize="13"
                                VerticalAlignment="Center"
                                Visibility="Collapsed"
                                Click="OnChangeMap"/>
                        <Button x:Name="BtnPlay"
                                Style="{StaticResource PlayBarButton}"
                                Content="{loc:T play}"
                                Height="48" MinWidth="190"
                                FontSize="16"
                                RenderTransformOrigin="0.5,0.5"
                                MouseEnter="OnPlayHover" MouseLeave="OnPlayHover"
                                VerticalAlignment="Center"
                                Click="OnPlay"/>
                      </StackPanel>

                      <StackPanel x:Name="PanelPlayLive" Orientation="Horizontal" VerticalAlignment="Center"
                                  Visibility="Collapsed" Margin="6,0,0,0">
                        <Ellipse Width="10" Height="10" Margin="0,0,10,0" Fill="{DynamicResource Accent}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:T match_running}" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock x:Name="TxtPlayLiveDetail" FontSize="14" Margin="10,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                      </StackPanel>

                      <StackPanel x:Name="PanelSimplePlayOptions" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnPillServer" Style="{StaticResource PillButton}" Click="OnPillServerClick"
                                ToolTip="{loc:T tip_tick_rate}">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:T adv_server}" VerticalAlignment="Center"

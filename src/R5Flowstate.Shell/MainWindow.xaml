          </Style>
        </Border.Style>
        <StackPanel VerticalAlignment="Top">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding By, Mode=OneWay}"
                       FontSize="12" Margin="10,1,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>

      <Border BorderThickness="2,0,0,0" Padding="16,12,16,14" Margin="0,0,20,14"
              Cursor="Hand" VerticalAlignment="Top"
              Tag="{Binding Url}" MouseLeftButtonUp="OnCreditRowClick"
              ToolTip="{Binding Url, Mode=OneWay}">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLine}"/>
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceBg}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>

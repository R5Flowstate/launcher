<Window x:Class="R5Flowstate.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:R5Flowstate.Shell"
        xmlns:loc="clr-namespace:R5Flowstate.Shell"
        Title="R5Flowstate"
        Icon="{DynamicResource AppIcon}"
        Height="737" Width="1135"
        MinHeight="640" MinWidth="1080"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        PreviewKeyDown="OnWindowPreviewKeyDown">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0"
                  ResizeBorderThickness="6"
                  GlassFrameThickness="0"
                  CornerRadius="0"
                  UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>

    <DataTemplate x:Key="ServerRowTemplate">
      <Border Background="{DynamicResource SurfaceBg}"
              CornerRadius="4" Padding="14,11" Margin="0,0,0,8">
        <DockPanel>
          <Button DockPanel.Dock="Left"
                  Style="{StaticResource FavoriteStar}"
                  Content="{Binding FavoriteGlyph}"
                  Tag="{Binding}"
                  VerticalAlignment="Center" Margin="0,0,12,0"
                  Click="OnToggleFavorite"
                  ToolTip="{loc:T tip_favorite}"/>
          <Button DockPanel.Dock="Right"
                  Style="{StaticResource AccentButton}"
                  Content="{Binding JoinCaption}"
                  Width="84" Height="34" Margin="14,0,0,0"
                  VerticalAlignment="Center"
                  IsEnabled="{Binding JoinEnabled}"
                  ToolTip="{Binding JoinHint}"
                  Tag="{Binding}"
                   Click="OnJoinServerClick"/>
          <StackPanel VerticalAlignment="Center">
            <DockPanel>
              <Viewbox DockPanel.Dock="Left" Width="12" Height="12" Margin="0,1,7,0"
                       VerticalAlignment="Center"
                       Visibility="{Binding HasPassword, Converter={StaticResource BoolVis}}"
                       ToolTip="{loc:T tip_password}">
                <Path Fill="{DynamicResource TextSecondary}" Stretch="Uniform"
                      Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
              </Viewbox>
              <Border DockPanel.Dock="Left" Margin="0,0,8,0" Padding="6,1" CornerRadius="3"
                      Background="{DynamicResource AccentDim}" VerticalAlignment="Center"
                      Visibility="{Binding HasModRequirement, Converter={StaticResource BoolVis}}"
                      ToolTip="{Binding ModTooltip}">
                <TextBlock Text="{Binding ModBadge}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBright}"/>
              </Border>
              <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <TextBlock Text="{Binding Detail}" FontSize="12"
                       Margin="0,3,0,0" Foreground="{DynamicResource TextMuted}"
                       TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="ModBadgeTemplate">
      <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" Padding="7,1" Margin="8,0,0,0"
                 VerticalAlignment="Center">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsWarning}" Value="True">
                <Setter Property="Background" Value="{DynamicResource DangerBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource DangerFg}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </DataTemplate>

    <DataTemplate x:Key="ModRowTemplate">
      <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Padding="4,12">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Opacity" Value="1"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding Enabled}" Value="False">
                <Setter Property="Opacity" Value="0.62"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Width="30" Height="30"
                  Margin="14,0,0,0" VerticalAlignment="Center"
                  IsEnabled="{Binding ActionsEnabled}" Tag="{Binding}" Click="OnModMore"
                  ToolTip="{loc:T mods_more}">
            <Path Data="M2,8 a1.6,1.6 0 1,0 3.2,0 a1.6,1.6 0 1,0 -3.2,0 M6.4,8 a1.6,1.6 0 1,0 3.2,0 a1.6,1.6 0 1,0 -3.2,0 M10.8,8 a1.6,1.6 0 1,0 3.2,0 a1.6,1.6 0 1,0 -3.2,0"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  Width="16" Height="16" Stretch="Uniform"/>
          </Button>
          <CheckBox DockPanel.Dock="Right" Style="{StaticResource FlatSwitch}"
                    Margin="16,0,0,0" VerticalAlignment="Center"
                    IsChecked="{Binding Enabled, Mode=OneWay}"
                    IsEnabled="{Binding ActionsEnabled}"
                    Tag="{Binding}"
                    Checked="OnModEnabledChanged"
                    Unchecked="OnModEnabledChanged"
                    ToolTip="{loc:T mods_enable}"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource FlatUpdateButton}" Height="30" FontSize="12.5"
                  Padding="12,0" Margin="16,0,0,0" VerticalAlignment="Center"
                  Content="{Binding UpdateCaption}" Tag="{Binding}" Click="OnModRowUpdate"
                  IsEnabled="{Binding ActionsEnabled}"
                  Visibility="{Binding HasUpdate, Converter={StaticResource BoolVis}}"/>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
            <Button Content="&#x25B2;" Width="24" Height="28" FontSize="9" Style="{StaticResource TextButton}"
                    IsEnabled="{Binding ActionsEnabled}" Tag="{Binding}" Click="OnModMoveUp"
                    ToolTip="{loc:T mods_move_up}"/>
            <Button Content="&#x25BC;" Width="24" Height="28" FontSize="9" Style="{StaticResource TextButton}"
                    IsEnabled="{Binding ActionsEnabled}" Tag="{Binding}" Click="OnModMoveDown"
                    ToolTip="{loc:T mods_move_down}"/>
          </StackPanel>
          <Grid DockPanel.Dock="Left" Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Center"
                Background="{DynamicResource SurfaceRaised}">
            <TextBlock Text="{Binding Initials}" FontSize="14" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}"/>
            <Image Source="{Binding IconSource}" Stretch="UniformToFill"
                   Visibility="{Binding HasIcon, Converter={StaticResource BoolVis}}"/>
          </Grid>
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Version, StringFormat=v{0}}" FontSize="12" Margin="8,0,0,0"
                         VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
              <ItemsControl ItemsSource="{Binding Badges}" ItemTemplate="{StaticResource ModBadgeTemplate}"
                            VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </StackPanel>
            <TextBlock Text="{Binding Detail}" FontSize="12" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="PluginRowTemplate">
      <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Padding="4,12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="{loc:T plugins_install}" Style="{StaticResource TextButtonAccent}"
                    Height="30" Padding="12,0" Margin="8,0,0,0"
                    Visibility="{Binding ShowInstall, Converter={StaticResource BoolVis}}"
                    Tag="{Binding}" Click="OnPluginInstall"/>
            <Button Content="{loc:T plugins_enable}" Style="{StaticResource TextButtonAccent}"
                    Height="30" Padding="12,0" Margin="8,0,0,0"
                    Visibility="{Binding ShowEnable, Converter={StaticResource BoolVis}}"
                    Tag="{Binding}" Click="OnPluginEnable"/>
            <Button Content="{loc:T plugins_disable}" Style="{StaticResource TextButton}"
                    Height="30" Padding="12,0" Margin="8,0,0,0"
                    Visibility="{Binding ShowDisable, Converter={StaticResource BoolVis}}"
                    Tag="{Binding}" Click="OnPluginDisable"/>
            <Button Content="{loc:T plugins_remove}" Style="{StaticResource TextButton}"
                    Height="30" Padding="12,0" Margin="8,0,0,0"
                    Visibility="{Binding ShowRemove, Converter={StaticResource BoolVis}}"
                    Tag="{Binding}" Click="OnPluginRemove"/>
          </StackPanel>
          <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimary}"/>
              <TextBlock Text="{Binding Version, StringFormat=v{0}}" FontSize="12" Margin="8,0,0,0"
                         VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
              <TextBlock Text="{Binding Status}" FontSize="12" Margin="8,0,0,0"
                         VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
            </StackPanel>
            <TextBlock Text="{Binding Meta}" FontSize="12" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Caps}" FontSize="12" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding NativeNote}" FontSize="12" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"
                       Visibility="{Binding ShowNativeNote, Converter={StaticResource BoolVis}}"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="ModFilterChipTemplate">
      <Button Content="{Binding Label}" Tag="{Binding}" Click="OnBrowseCategoryClick">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource FilterTab}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsOn}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
    </DataTemplate>

    <DataTemplate x:Key="BrowseModCardTemplate">
      <Button Margin="0,0,12,12" Tag="{Binding}" Click="OnBrowseCardClick" MouseDoubleClick="OnBrowseCardDoubleClick">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource ModCard}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
        <StackPanel>
          <Grid Height="120" Background="{DynamicResource SurfaceSunken}" ClipToBounds="True">
            <TextBlock Text="{Binding Initials}" FontSize="30" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMuted}"/>
            <Image Source="{Binding IconSource}" Stretch="UniformToFill"
                   Visibility="{Binding HasIcon, Converter={StaticResource BoolVis}}"/>
            <TextBlock Text="{Binding StateLabel}" FontSize="11" FontWeight="Bold" Padding="7,2"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                       Visibility="{Binding ShowState, Converter={StaticResource BoolVis}}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Background" Value="{DynamicResource AccentDim}"/>
                  <Setter Property="Foreground" Value="{DynamicResource AccentBright}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource UpdateFill}"/>
                      <Setter Property="Foreground" Value="{DynamicResource UpdateText}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
          <StackPanel Margin="12,10,12,12">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding LatestVersion, StringFormat=v{0}}" FontSize="11"
                         Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
              <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <TextBlock Text="{Binding OwnerLine}" FontSize="12" Margin="0,2,0,0"
                       Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <TextBlock Text="{loc:T mods_badge_verified}" FontSize="11" FontWeight="SemiBold" Padding="7,1"
                         Background="{DynamicResource AccentDim}" Foreground="{DynamicResource AccentBright}"/>
              <TextBlock Text="{loc:T mods_badge_official}" FontSize="11" FontWeight="SemiBold" Padding="7,1" Margin="6,0,0,0"
                         Background="{DynamicResource SurfaceRaised}" Foreground="{DynamicResource TextPrimary}"
                         Visibility="{Binding IsOfficial, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
            <TextBlock Text="{Binding MetaLine}" FontSize="11.5" Margin="0,6,0,0"
                       Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </StackPanel>
      </Button>
    </DataTemplate>

    <Style x:Key="QueueStepRun" TargetType="Run">
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
    </Style>

    <DataTemplate x:Key="ModQueueTemplate">
      <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Padding="0,14">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,4,0,0">
            <TextBlock Text="{loc:T mods_browse_installed}" FontSize="12.5" Foreground="{DynamicResource Accent}"
                       Visibility="{Binding IsDone, Converter={StaticResource BoolVis}}"/>
            <Button Content="{loc:T mods_q_copy}" Style="{StaticResource TextButton}" Margin="0,0,16,0"
                    Tag="{Binding}" Click="OnModQueueCopy"
                    Visibility="{Binding IsFailed, Converter={StaticResource BoolVis}}"/>
            <Button Content="{loc:T mods_q_retry}" Style="{StaticResource TextButtonAccent}"
                    Tag="{Binding}" Click="OnModQueueRetry"
                    Visibility="{Binding CanRetry, Converter={StaticResource BoolVis}}"/>
            <Button Content="{loc:T cancel_title}" Style="{StaticResource TextButton}"
                    Tag="{Binding}" Click="OnModQueueCancel"
                    Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}"/>
          </StackPanel>
          <Grid DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,16,0" VerticalAlignment="Top"
                Background="{DynamicResource SurfaceRaised}">
            <TextBlock Text="{Binding Initials}" FontSize="13" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}"/>
            <Image Source="{Binding IconSource}" Stretch="UniformToFill"
                   Visibility="{Binding HasIcon, Converter={StaticResource BoolVis}}"/>
          </Grid>
          <StackPanel>
            <TextBlock FontSize="14" TextTrimming="CharacterEllipsis">
              <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
              <Run Text="  "/>
              <Run Text="{Binding Subtitle, Mode=OneWay}" Foreground="{DynamicResource TextSecondary}"/>
            </TextBlock>
            <TextBlock FontSize="12" Margin="0,4,0,0"
                       Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}">
              <Run Text="{loc:T mods_step_download}">
                <Run.Style>
                  <Style TargetType="Run" BasedOn="{StaticResource QueueStepRun}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding StepDownload}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Run.Style>
              </Run>
              <Run Text="   /   " Foreground="{DynamicResource TextMuted}"/>
              <Run Text="{loc:T mods_step_unpack}">
                <Run.Style>
                  <Style TargetType="Run" BasedOn="{StaticResource QueueStepRun}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding StepUnpack}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Run.Style>
              </Run>
              <Run Text="   /   " Foreground="{DynamicResource TextMuted}"/>
              <Run Text="{loc:T mods_step_check}">
                <Run.Style>
                  <Style TargetType="Run" BasedOn="{StaticResource QueueStepRun}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding StepCheck}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Run.Style>
              </Run>
              <Run Text="   /   " Foreground="{DynamicResource TextMuted}"/>
              <Run Text="{loc:T mods_step_install}">
                <Run.Style>
                  <Style TargetType="Run" BasedOn="{StaticResource QueueStepRun}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding StepInstall}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Run.Style>
              </Run>
            </TextBlock>
            <TextBlock Text="{Binding StatusLine}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource DangerFg}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <ProgressBar Value="{Binding Percent, Mode=OneWay}" Margin="0,10,0,0"
                         Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}">
              <ProgressBar.Style>
                <Style TargetType="ProgressBar" BasedOn="{StaticResource FlatBar}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding StepDownload}" Value="False">
                      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ProgressBar.Style>
            </ProgressBar>
            <DockPanel Margin="0,8,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}">
              <TextBlock DockPanel.Dock="Right" Text="{Binding DetailLine}" FontSize="12" Margin="16,0,0,0"
                         MaxWidth="360" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMuted}"/>
              <TextBlock FontSize="12.5" Foreground="{DynamicResource TextSecondary}">
                <Run Text="{Binding PercentText, Mode=OneWay}" Foreground="{DynamicResource TextPrimary}"/>
                <Run Text="      "/>
                <Run Text="{Binding BytesLine, Mode=OneWay}"/>
                <Run Text="      "/>
                <Run Text="{Binding RateText, Mode=OneWay}"/>
                <Run Text="      "/>
                <Run Text="{Binding EtaText, Mode=OneWay}"/>
              </TextBlock>
            </DockPanel>
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="ReplayRowTemplate">
      <StackPanel>
        <TextBlock Text="{Binding DayHeader}" Visibility="{Binding DayHeaderVisibility}"
                   FontSize="13" FontWeight="SemiBold" Margin="4,14,0,6"
                   Foreground="{DynamicResource TextSecondary}"/>
        <Border CornerRadius="8" Margin="0,0,0,2" Padding="8">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="Transparent"/>
              <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="112" Height="63" CornerRadius="6" VerticalAlignment="Top"
                    Background="{DynamicResource SurfaceSunken}">
              <Grid>
                <Image Source="{Binding Art}" Stretch="UniformToFill"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Image.Clip>
                    <RectangleGeometry Rect="0,0,112,63" RadiusX="6" RadiusY="6"/>
                  </Image.Clip>
                </Image>
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4"
                        Background="#CC000000" CornerRadius="3" Padding="4,1">
                  <TextBlock Text="{Binding LengthText}" FontFamily="Consolas" FontSize="11"
                             Foreground="White"/>
                </Border>
              </Grid>
            </Border>

            <StackPanel Grid.Column="1" Margin="14,2,16,0" VerticalAlignment="Top">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding MapText}" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding ResultText}" FontSize="13" FontWeight="Bold" Margin="10,0,0,0"
                           VerticalAlignment="Bottom" Foreground="{Binding ResultBrush}"/>
              </StackPanel>
              <TextBlock Text="{Binding InfoLine}" FontSize="12" Margin="0,4,0,0"
                         Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
              <Border Width="220" Height="6" CornerRadius="3" HorizontalAlignment="Left" Margin="0,8,0,0"
                      Background="{DynamicResource SurfaceSunken}" Visibility="{Binding StripVisibility}">
                <ItemsControl ItemsSource="{Binding Ticks}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <Canvas/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                      <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                    </Style>
                  </ItemsControl.ItemContainerStyle>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Rectangle Width="3" Height="6" RadiusX="1" RadiusY="1" Fill="{Binding Fill}"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
              <ItemsControl ItemsSource="{Binding Chapters}" Margin="0,8,0,0"
                            Visibility="{Binding ChaptersVisibility}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Width="{Binding Width}" Height="24" Margin="0,0,3,3" Padding="4,0" MinWidth="0"
                            Background="{Binding Background}" BorderBrush="{Binding Border}" BorderThickness="1"
                            Foreground="{Binding Foreground}" FontSize="11" FontWeight="SemiBold"
                            Content="{Binding Label}" ToolTip="{Binding Tip}" Cursor="Hand"
                            Tag="{Binding}" Click="OnReplayWatchChapter"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding Clips}" Visibility="{Binding ClipsVisibility}" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                      <Button Style="{StaticResource GhostButton}" MinWidth="0" Height="24" Padding="8,0"
                              FontSize="11" Content="{loc:T replays_watch_clip}"
                              Tag="{Binding}" Click="OnReplayWatchClip"/>
                      <TextBlock Text="{Binding Label}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding BookmarksText}" Visibility="{Binding BookmarksVisibility}"
                         FontSize="12" Margin="0,6,0,0" Foreground="{DynamicResource TextMuted}"
                         TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right">
              <TextBlock Text="{Binding TimeText}" FontSize="12" HorizontalAlignment="Right" Margin="0,2,0,8"
                         Foreground="{DynamicResource TextMuted}"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="32" Height="32" Style="{StaticResource GhostButton}" Padding="0" MinWidth="0"
                        ToolTip="{Binding PinTip}" Tag="{Binding}" Click="OnReplayPin">
                  <Path Data="M8,1.5 L9.9,5.6 L14.3,6 L11,9 L12,13.4 L8,11.2 L4,13.4 L5,9 L1.7,6 L6.1,5.6 Z"
                        Fill="{Binding PinFill}" Stroke="{DynamicResource PingFair}" StrokeThickness="1.2"
                        Width="15" Height="15" Stretch="Uniform"/>
                </Button>
                <Button Width="32" Height="32" Margin="4,0,0,0" Style="{StaticResource GhostButton}"
                        Padding="0" MinWidth="0" ToolTip="{loc:T replays_delete}"
                        Tag="{Binding}" Click="OnReplayDelete">
                  <Path Data="M3,4 H13 M6,4 V2.5 H10 V4 M4.5,4 L5.2,14 H10.8 L11.5,4 M7,6.5 V11.5 M9,6.5 V11.5"
                        Stroke="{DynamicResource DangerFg}" StrokeThickness="1.3" Fill="Transparent"
                        Width="14" Height="14" Stretch="Uniform"/>
                </Button>
                <Button Style="{StaticResource AccentButton}" Content="{loc:T replays_watch}"
                        Width="96" Height="32" Margin="8,0,0,0" Tag="{Binding}" Click="OnReplayWatch"/>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="DediModPolicyRowTemplate">
      <Border>
        <DockPanel Height="38">
          <Border DockPanel.Dock="Right" Style="{StaticResource SegmentBar}" Padding="1">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource ModSegOff}" Tag="0" Content="{loc:T mods_policy_choice_off}"
                      Click="OnDediModRowPolicyClick"/>
              <Button Style="{StaticResource ModSegRequired}" Tag="1" Content="{loc:T mods_policy_choice_req}"
                      Click="OnDediModRowPolicyClick"/>
              <Button Style="{StaticResource ModSegAllowed}" Tag="2" Content="{loc:T mods_policy_choice_allow}"
                      Click="OnDediModRowPolicyClick"/>
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding Name}" FontSize="13"
                     Foreground="{DynamicResource TextPrimary}"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     Margin="0,0,10,0"/>
        </DockPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="PatchNoteRowTemplate">
      <Border BorderBrush="{DynamicResource BorderLine}" BorderThickness="2,0,0,0"
              Background="Transparent" Padding="16,12,16,14" Margin="0,0,0,16">
        <StackPanel>
          <DockPanel Margin="0,0,0,2">
            <TextBlock DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource TextMuted}"
                       VerticalAlignment="Center" Margin="12,0,0,0"
                       Text="{Binding Date, Mode=OneWay}"/>
            <TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <Rectangle Height="1" Fill="{DynamicResource BorderSoft}" Margin="0,8,0,0"/>
          <ItemsControl ItemsSource="{Binding Items}" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,0,0,6">
                  <Rectangle x:Name="Bullet"
                             DockPanel.Dock="Left" Width="5" Height="5" RadiusX="1" RadiusY="1"
                             Margin="1,6,10,0" VerticalAlignment="Top"
                             Fill="{DynamicResource Accent}"/>
                  <TextBlock x:Name="Line" Text="{Binding Text, Mode=OneWay}" FontSize="13"
                             Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                </DockPanel>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsHeader, Mode=OneWay}" Value="True">
                    <Setter TargetName="Bullet" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Line" Property="FontWeight" Value="SemiBold"/>
                    <Setter TargetName="Line" Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                    <Setter TargetName="Line" Property="Margin" Value="0,10,0,2"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="BlogCardTemplate">
      <Border x:Name="Card" CornerRadius="10" Margin="0,0,0,10" Cursor="Hand" ClipToBounds="True"
              Tag="{Binding}" MouseLeftButtonUp="OnBlogCardClick" KeyDown="OnBlogCardKey"
              Focusable="True" ToolTip="{Binding Title, Mode=OneWay}">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel>
          <Border Height="170" ClipToBounds="True" Background="{DynamicResource SurfaceSunken}"
                  Visibility="{Binding HasCover, Converter={StaticResource BoolVis}}">
            <Grid>
              <TextBlock Text="R5" FontSize="22" FontWeight="Bold"
                         Foreground="{DynamicResource AccentTrack}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Image Source="{Binding CoverImage}" Stretch="UniformToFill"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     SnapsToDevicePixels="True"
                     Visibility="{Binding HasCoverImage, Converter={StaticResource BoolVis}}"/>
            </Grid>
          </Border>
          <StackPanel Margin="20,14,20,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
              <Border Padding="8,2" CornerRadius="4" Margin="0,0,8,0"
                      Background="{DynamicResource AccentDim}"
                      Visibility="{Binding HasTag, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding Tag, Mode=OneWay}" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBright}" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="{Binding Date, Mode=OneWay}" FontSize="11"
                         Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="17" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" TextAlignment="Center"
                       MaxHeight="42" TextTrimming="WordEllipsis"/>
            <TextBlock Text="{Binding Summary, Mode=OneWay}" FontSize="12.5" Margin="0,6,0,0"
                       Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" TextAlignment="Center"
                       MaxHeight="30" TextTrimming="WordEllipsis"
                       Visibility="{Binding HasSummary, Converter={StaticResource BoolVis}}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <Style x:Key="LbSort" TargetType="Button" BasedOn="{StaticResource GhostButton}">
      <Setter Property="Height" Value="26"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
      <Setter Property="HorizontalContentAlignment" Value="Right"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <DataTemplate x:Key="LeaderboardRowTemplate">
      <Border CornerRadius="4" Padding="12,9" Margin="0,0,0,6" Cursor="Hand"
              Tag="{Binding}" MouseLeftButtonUp="OnLeaderboardRowClick"
              ToolTip="{Binding Persona}">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentDim}"/>
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
              </Trigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsSelected}" Value="True"/>
                  <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource AccentDim}"/>
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid MinWidth="1024">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="52"/>
            <ColumnDefinition Width="*" MinWidth="120"/>
            <ColumnDefinition Width="58"/>
            <ColumnDefinition Width="36"/>
            <ColumnDefinition Width="36"/>
            <ColumnDefinition Width="46"/>
            <ColumnDefinition Width="54"/>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="76"/>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="36"/>
            <ColumnDefinition Width="44"/>
            <ColumnDefinition Width="44"/>
            <ColumnDefinition Width="48"/>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="44"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{Binding RankLabel}" FontFamily="Consolas" FontSize="12"
                     TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsPodium}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBright}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Grid.Column="1" Text="{Binding Persona}" FontSize="13" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" Margin="4,0,8,0"/>
          <TextBlock Grid.Column="2" Text="{Binding ScoreLabel}" FontFamily="Consolas" FontSize="12"
                     Foreground="{DynamicResource TextPrimary}" TextAlignment="Right" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="3" Text="{Binding KillsLabel}" FontFamily="Consolas" FontSize="12"
                     Foreground="{DynamicResource TextSecondary}" TextAlignment="Right" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="4" Text="{Binding DeathsLabel}" FontFamily="Consolas" FontSize="12"
                     Foreground="{DynamicResource TextSecondary}" TextAlignment="Right" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="5" Text="{Binding KdLabel}" FontFamily="Consolas" FontSize="12"
                     Foreground="{DynamicResource TextPrimary}" TextAlignment="Right" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="6" Text="{Binding DamageLabel}" FontFamily="Consolas" FontSize="12"
                     Foreground="{DynamicResource TextSecondary}" TextAlignment="Right" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="7" Text="{Binding AccLabel}" FontFamily="Consolas" FontSize="12"
                     Foreground="{DynamicResource TextSecondary}" TextAlignment="Right" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="8" Text="{Binding WeaponLabel}" FontSize="12"
                     Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" Margin="8,0,4,0"/>
          <TextBlock Grid.Column="9" Text="{Binding InputLabel}" FontFamily="Consolas" FontSize="11"
                     Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="4,0,0,0"/>
          <TextBlock Grid.Column="10" Text="{Binding HsLabel}" FontFamily="Consolas" FontSize="12"
                     Foreground="{DynamicResource TextSecondary}" TextAlignment="Right" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="11" Text="{Binding HitsLabel}" FontFamily="Consolas" FontSize="12"
                     Foreground="{DynamicResource TextSecondary}" TextAlignment="Right" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="12" Text="{Binding WinsLabel}" FontFamily="Consolas" FontSize="12"
                     Foreground="{DynamicResource TextSecondary}" TextAlignment="Right" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="13" Text="{Binding GamesLabel}" FontFamily="Consolas" FontSize="12"
                     Foreground="{DynamicResource TextSecondary}" TextAlignment="Right" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="14" Text="{Binding WrLabel}" FontFamily="Consolas" FontSize="12"
                     Foreground="{DynamicResource TextPrimary}" TextAlignment="Right" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="15" Text="{Binding StreakLabel}" FontFamily="Consolas" FontSize="12"
                     Foreground="{DynamicResource TextSecondary}" TextAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="LbMatchRowTemplate">
      <DockPanel Margin="0,0,0,6" Background="Transparent" Cursor="Hand"
                 Tag="{Binding}" MouseLeftButtonUp="OnLbRecentMatchClick"
                 ToolTip="{loc:T lb_match_open}">
        <TextBlock DockPanel.Dock="Left" Text="{Binding Result}" FontFamily="Consolas"
                   FontWeight="SemiBold" FontSize="13" MinWidth="22" VerticalAlignment="Center">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsWin}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLoss}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource DangerLine}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <TextBlock DockPanel.Dock="Right" Text="{Binding AtLabel}" FontSize="11"
                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
        <TextBlock DockPanel.Dock="Right" Text="{Binding HostLabel}" FontSize="11"
                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" MinWidth="72"
                   TextTrimming="CharacterEllipsis" Margin="12,0,0,0"/>
        <TextBlock DockPanel.Dock="Right" Text="{Binding DurationLabel}" FontFamily="Consolas" FontSize="12"
                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" MinWidth="36"
                   TextAlignment="Right" Margin="12,0,0,0"/>
        <TextBlock DockPanel.Dock="Right" Text="{Binding DamageLabel}" FontFamily="Consolas" FontSize="12"
                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" MinWidth="48"
                   TextAlignment="Right" Margin="12,0,0,0"/>
        <TextBlock DockPanel.Dock="Right" Text="{Binding KdLabel}" FontFamily="Consolas" FontSize="12"
                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" MinWidth="40"
                   TextAlignment="Right" Margin="12,0,0,0"/>
        <TextBlock>
          <Run Text="{loc:T vs}" Foreground="{DynamicResource TextMuted}"/>
          <Run Text="{Binding Opponent, Mode=OneWay}" Foreground="{DynamicResource TextPrimary}"/>
          <Run Text="  ·  " Foreground="{DynamicResource TextMuted}"/>
          <Run Text="{Binding MapLabel, Mode=OneWay}" Foreground="{DynamicResource TextSecondary}"/>
          <Run Text="  ·  " Foreground="{DynamicResource TextMuted}"/>
          <Run Text="{Binding WeaponLabel, Mode=OneWay}" Foreground="{DynamicResource TextMuted}"/>
        </TextBlock>
      </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="LbHistoryRowTemplate">
      <Border Background="{DynamicResource SurfaceBg}" CornerRadius="4" Padding="12,10" Margin="0,0,0,6"
              Tag="{Binding}" Cursor="Hand" MouseLeftButtonUp="OnLbHistoryRowClick"
              ToolTip="{loc:T lb_match_open}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Text="{Binding ScoreLabel}" FontFamily="Consolas"
                     FontWeight="SemiBold" FontSize="14" MinWidth="56" VerticalAlignment="Center"
                     Foreground="{DynamicResource AccentBright}"/>
          <TextBlock DockPanel.Dock="Right" Text="{Binding AtLabel}" FontSize="11"
                     Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
          <TextBlock DockPanel.Dock="Right" Text="{Binding HostLabel}" FontSize="11"
                     Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" MinWidth="72"
                     TextTrimming="CharacterEllipsis" Margin="12,0,0,0"/>
          <TextBlock DockPanel.Dock="Right" Text="{Binding DurationLabel}" FontFamily="Consolas" FontSize="12"
                     Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" MinWidth="36"
                     TextAlignment="Right" Margin="12,0,0,0"/>
          <TextBlock DockPanel.Dock="Right" Text="{Binding DamageLabel}" FontFamily="Consolas" FontSize="12"
                     Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" MinWidth="56"
                     TextAlignment="Right" Margin="12,0,0,0"/>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                       FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
              <Run Text="{Binding MapLabel, Mode=OneWay}" Foreground="{DynamicResource TextSecondary}"/>
              <Run Text="  &#183;  " Foreground="{DynamicResource TextMuted}"/>
              <Run Text="{Binding PlaylistLabel, Mode=OneWay}" Foreground="{DynamicResource TextMuted}"/>
            </TextBlock>
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="MatchPlayerRowTemplate">
      <Border Background="{DynamicResource SurfaceRaised}" CornerRadius="4" Padding="12,10" Margin="0,0,0,6"
              Tag="{Binding}" Cursor="Hand" MouseLeftButtonUp="OnMatchPlayerClick"
              ToolTip="{loc:T lb_match_open_player}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Text="{Binding Result}" FontFamily="Consolas"
                     FontWeight="SemiBold" FontSize="13" MinWidth="26" VerticalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsWin}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsLoss}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DangerLine}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding KillsLabel}" FontFamily="Consolas" FontSize="12" MinWidth="34"
                       TextAlignment="Right" Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="{Binding DeathsLabel}" FontFamily="Consolas" FontSize="12" MinWidth="34"
                       TextAlignment="Right" Foreground="{DynamicResource TextSecondary}"/>
            <TextBlock Text="{Binding DamageLabel}" FontFamily="Consolas" FontSize="12" MinWidth="56"
                       TextAlignment="Right" Foreground="{DynamicResource TextSecondary}"/>
            <TextBlock Text="{Binding HsLabel}" FontFamily="Consolas" FontSize="12" MinWidth="34"
                       TextAlignment="Right" Foreground="{DynamicResource TextMuted}"/>
            <TextBlock Text="{Binding HitsLabel}" FontFamily="Consolas" FontSize="12" MinWidth="42"
                       TextAlignment="Right" Foreground="{DynamicResource TextMuted}"/>
            <TextBlock Text="{Binding AccLabel}" FontFamily="Consolas" FontSize="12" MinWidth="52"
                       TextAlignment="Right" Foreground="{DynamicResource TextMuted}"/>
          </StackPanel>
          <StackPanel Margin="6,0,12,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Persona}" FontSize="13" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
              <Run Text="{Binding WeaponLabel, Mode=OneWay}" Foreground="{DynamicResource TextMuted}"/>
              <Run Text="  &#183;  " Foreground="{DynamicResource TextMuted}"/>
              <Run Text="{Binding InputLabel, Mode=OneWay}" Foreground="{DynamicResource TextMuted}"/>
            </TextBlock>
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="LbSplitRowTemplate">
      <DockPanel Margin="0,0,0,4">
        <TextBlock DockPanel.Dock="Right" Text="{Binding Extra}" FontFamily="Consolas" FontSize="11"
                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
        <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      </DockPanel>
    </DataTemplate>


              <Viewbox Width="15" Height="15">
                <Path Fill="{StaticResource TextSecondary}" Stretch="Uniform"
                      Data="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028 14.09 14.09 0 001.226-1.994.076.076 0 00-.041-.106 13.107 13.107 0 01-1.872-.892.077.077 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.198.373.292a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.892.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
              </Viewbox>
            </Button>
            <Button Style="{StaticResource FooterIcon}" Click="OnOpenGitHub" ToolTip="{loc:T tip_github}">
              <Viewbox Width="15" Height="15">
                <Path Fill="{StaticResource TextSecondary}" Stretch="Uniform"
                      Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
              </Viewbox>
            </Button>
            <TextBlock x:Name="TxtShellUpdateLink" Visibility="Collapsed"
                       Margin="10,0,0,0" FontSize="11.5" VerticalAlignment="Center">
              <Hyperlink Click="OnShellUpdateLinkClick"
                         ToolTip="{loc:T tip_update}">
                <Run x:Name="RunShellUpdateLink" Text="{loc:T update_available}"/>
              </Hyperlink>
            </TextBlock>
            <TextBlock x:Name="TxtSimpleVersion" Margin="8,0,0,0"
                       FontFamily="Consolas" FontSize="11.5"
                       Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
          </StackPanel>
          <Grid VerticalAlignment="Center" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="DotSimpleStatus" Grid.Column="0" Width="6" Height="6"
                     Margin="0,0,8,0" VerticalAlignment="Center"
                     Fill="{StaticResource Accent}"/>
            <TextBlock x:Name="TxtSimpleStatus" Grid.Column="1" Text="{loc:T ready_to_play}"
                       FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextMuted}"
                       VerticalAlignment="Center"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"/>
          </Grid>
        </DockPanel>
        </Border>
        <Grid Background="{StaticResource SurfaceBg}">
          <DockPanel x:Name="PanelSimpleLocal">
            <ProgressBar x:Name="BarSimpleInstall" DockPanel.Dock="Bottom"
                         Height="6" Minimum="0" Maximum="100" Value="0"
                         Margin="0,10,0,0"
                         Visibility="Collapsed"/>
            <Border x:Name="BarSimplePlay" DockPanel.Dock="Bottom" Margin="0" Padding="16,12"
                    Background="Transparent"
                    BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0">
              <!-- The password field is the only elastic cell: options and the play
                   button keep their desired width, the star column absorbs the rest.
                   ClipToBounds so nothing here can ever paint over the play button. -->
              <Grid VerticalAlignment="Center" ClipToBounds="True">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center">
                  <Button x:Name="BtnChangeMap"
                          Style="{StaticResource GhostButton}"
                          Content="{loc:T change_map}"
                          MinWidth="128" Height="44" Padding="16,0"
                          Margin="0,0,10,0"
                          FontSize="13"
                          VerticalAlignment="Center"
                          Visibility="Collapsed"
                          Click="OnChangeMap"/>
                  <Button x:Name="BtnPlay"
                          Style="{StaticResource PlayBarButton}"
                          Content="{loc:T play}"
                          VerticalAlignment="Center"
                          Click="OnPlay"/>
                </StackPanel>
                <StackPanel x:Name="PanelSimplePlayOptions" Grid.Column="0"
                            Orientation="Horizontal" VerticalAlignment="Center">
                  <CheckBox x:Name="ChkSimpleCheats" Content="{loc:T cheats}"
                            Style="{StaticResource QuietCheck}"
                            ToolTip="{loc:T tip_cheats}"
                            IsChecked="True"
                            VerticalAlignment="Center"
                            Checked="OnSimpleLaunchOptionsChanged"
                            Unchecked="OnSimpleLaunchOptionsChanged"/>
                  <CheckBox x:Name="ChkSimpleDeveloper" Content="{loc:T developer}"
                            Style="{StaticResource QuietCheck}"
                            ToolTip="{loc:T tip_developer}"
                            VerticalAlignment="Center"
                            Checked="OnSimpleLaunchOptionsChanged"
                            Unchecked="OnSimpleLaunchOptionsChanged"/>
                  <CheckBox x:Name="ChkUseDx12" Content="{loc:T directx12}"
                            Style="{StaticResource QuietCheck}"
                            ToolTip="{loc:T tip_dx12}"
                            VerticalAlignment="Center"
                            Checked="OnUseDx12Changed"
                            Unchecked="OnUseDx12Changed"/>
                  <Border Width="1" Height="16" Margin="0,0,16,0" VerticalAlignment="Center"
                          Background="{StaticResource BorderSoft}"/>
                  <Button x:Name="BtnResolutionPreset"
                          Style="{StaticResource GhostButton}"
                          Content="{loc:T label_resolution_short}"
                          MinWidth="0" Height="30" Padding="10,0" Margin="0,0,8,0"
                          FontSize="13"
                          VerticalAlignment="Center"
                          ToolTip="{loc:T tip_resolution}"
                          Click="OnResolutionPresetClick"/>
                  <TextBox x:Name="TxtClientWidth" Width="60" Height="30"
                           VerticalAlignment="Center"
                           ToolTip="{loc:T tip_resolution}"
                           LostFocus="OnClientResolutionLostFocus"/>
                  <TextBlock Text="x" Margin="6,0,6,0" VerticalAlignment="Center"
                             Foreground="{StaticResource TextSecondary}"/>
                  <TextBox x:Name="TxtClientHeight" Width="60" Height="30"
                           VerticalAlignment="Center"
                           ToolTip="{loc:T tip_resolution}"
                           LostFocus="OnClientResolutionLostFocus"/>
                  <Border Width="1" Height="16" Margin="16,0,16,0" VerticalAlignment="Center"
                          Background="{StaticResource BorderSoft}"/>
                  <CheckBox x:Name="ChkSimpleOffline" Content="{loc:T offline}"
                            Style="{StaticResource QuietCheck}"
                            ToolTip="{loc:T tip_offline}"
                            VerticalAlignment="Center"
                            Checked="OnSimpleOfflineChanged"
                            Unchecked="OnSimpleOfflineChanged"/>
                  <CheckBox x:Name="ChkSimplePassword" Content="{loc:T password}"
                            Style="{StaticResource QuietCheck}"
                            ToolTip="{loc:T tip_password_lock}"
                            VerticalAlignment="Center"
                            Checked="OnPasswordProtectChanged"
                            Unchecked="OnPasswordProtectChanged"/>
                </StackPanel>
                <PasswordBox x:Name="TxtSimplePassword" Grid.Column="1" Height="30"
                             MinWidth="72" MaxWidth="420" Margin="0,0,12,0"
                             HorizontalAlignment="Stretch" VerticalAlignment="Center"
                             Visibility="Collapsed"
                             ToolTip="{loc:T tip_password_charset}"
                             PasswordChanged="OnDediPasswordChanged"
                             LostFocus="OnDediPasswordLostFocus"/>
              </Grid>
            </Border>
            <Grid>
              <Grid x:Name="PanelSimplePlay" Margin="14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="212"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Margin="0,0,12,0" CornerRadius="9" Padding="6"
                        Background="{StaticResource SurfaceSunken}"
                        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
                  <ScrollViewer VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ListModes" HorizontalAlignment="Stretch">
                      <ItemsControl.GroupStyle>
                        <GroupStyle>
                          <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                              <DockPanel Margin="2,9,2,5">
                                <TextBlock Text="{Binding Name}"
                                           Style="{StaticResource ModeRailGroup}"
                                           Margin="6,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ItemCount}"
                                           DockPanel.Dock="Right" Margin="8,0,6,0"
                                           FontFamily="Consolas" FontSize="10"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource BorderStrong}"/>
                                <Separator Background="{StaticResource BorderSoft}"
                                           Height="1" Margin="0" VerticalAlignment="Center"/>
                              </DockPanel>
                            </DataTemplate>
                          </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                      </ItemsControl.GroupStyle>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button ToolTip="{Binding Blurb}"
                                  Tag="{Binding}"
                                  Style="{StaticResource ModeRailItem}"
                                  Click="OnModeChipClick">
                            <DockPanel LastChildFill="True">
                              <TextBlock Text="{Binding MapCountLabel}"
                                         DockPanel.Dock="Right" Margin="8,0,0,0"
                                         VerticalAlignment="Center"
                                         FontFamily="Consolas" FontSize="10">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                              <TextBlock Text="{Binding Title}"
                                         VerticalAlignment="Center"
                                         TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Border>
                <Border Grid.Column="1" CornerRadius="9" ClipToBounds="True"
                        Background="#121816"
                        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
                  <Grid MinHeight="280" local:RoundedClip.Radius="9">
                    <Image x:Name="ImgLoadscreen"
                           Stretch="UniformToFill"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="LowQuality"/>
                    <Border VerticalAlignment="Bottom" Height="120">
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                          <GradientStop Color="#00121814" Offset="0"/>
                          <GradientStop Color="#E0121814" Offset="1"/>
                        </LinearGradientBrush>
                      </Border.Background>
                    </Border>
                    <StackPanel VerticalAlignment="Bottom" Margin="20,0,190,18">
                      <TextBlock x:Name="TxtHeroTitle" Text="{loc:T pick_a_map}"
                                 FontSize="27" FontWeight="SemiBold"
                                 Foreground="#f4f7f5" TextTrimming="CharacterEllipsis"/>
                      <TextBlock x:Name="TxtHeroSubtitle" Text=""
                                 FontSize="13" Foreground="#b8c8bc"
                                 Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                      <TextBlock x:Name="TxtHeroCommand" Text=""
                                 Style="{StaticResource MonoNote}"
                                 Foreground="#8aa094" Opacity="0.85"
                                 TextWrapping="NoWrap"
                                 Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Bottom" Margin="0,0,12,12">
                      <Button x:Name="BtnMapPicker"
                              Height="32" Margin="0,0,6,0" Padding="13,0"
                              Style="{StaticResource GhostButton}"
                              Background="#B3101613"
                              BorderBrush="#2EF4F7F5" BorderThickness="1"
                              Foreground="{StaticResource TextPrimary}"
                              Visibility="Collapsed"
                              Click="OnToggleMapPicker"
                              ToolTip="{loc:T tip_pick_map_art}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <Viewbox Width="13" Height="13" Margin="0,0,8,0">
                            <Canvas Width="16" Height="16">
                              <Rectangle Canvas.Left="0" Canvas.Top="0" Width="7" Height="7" RadiusX="1.5" RadiusY="1.5"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                              <Rectangle Canvas.Left="9" Canvas.Top="0" Width="7" Height="7" RadiusX="1.5" RadiusY="1.5"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                              <Rectangle Canvas.Left="0" Canvas.Top="9" Width="7" Height="7" RadiusX="1.5" RadiusY="1.5"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                              <Rectangle Canvas.Left="9" Canvas.Top="9" Width="7" Height="7" RadiusX="1.5" RadiusY="1.5"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Canvas>
                          </Viewbox>
                          <TextBlock Text="{loc:T select_map}" FontSize="13" FontWeight="Medium"/>
                        </StackPanel>
                      </Button>
                      <Button x:Name="BtnReloadLoadscreen"
                              Width="36" Height="36" Padding="0"
                              Style="{StaticResource GhostButton}"
                              Background="#B3101613"
                              BorderBrush="#2EF4F7F5" BorderThickness="1"
                              Visibility="Collapsed"
                              Click="OnReloadLoadscreen"
                              ToolTip="{loc:T tip_shuffle_loadscreen}">
                        <Viewbox Width="15" Height="15">
                          <Canvas Width="16" Height="16">
                            <Path Stroke="{StaticResource TextSecondary}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 14 8 A 6 6 0 1 1 12.2 3.8"/>
                            <Path Fill="{StaticResource TextSecondary}"
                                  Data="M 15.2 1 L 15.2 5.2 L 11 5.2 Z"/>
                          </Canvas>
                        </Viewbox>
                      </Button>
                    </StackPanel>

                    <Border x:Name="PanelMapPicker" Visibility="Collapsed"
                            Background="#F2111815">
                      <DockPanel Margin="16,14,16,14">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                          <Button DockPanel.Dock="Right" Width="36" Height="32" Padding="0"
                                  Style="{StaticResource GhostButton}"
                                  Click="OnToggleMapPicker"
                                  ToolTip="{loc:T close}">
                            <Viewbox Width="12" Height="12">
                              <Canvas Width="12" Height="12">
                                <Path Stroke="{StaticResource TextSecondary}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 1 1 L 11 11 M 11 1 L 1 11"/>
                              </Canvas>
                            </Viewbox>
                          </Button>
                          <TextBlock Text="{loc:T choose_map}" Style="{StaticResource SectionLabel}"
                                     Margin="0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                          <ItemsControl x:Name="ListMapTiles">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel/>
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Button Tag="{Binding}" Click="OnMapTileClick"
                                        Style="{StaticResource MapTile}"
                                        ToolTip="{Binding Stem}"/>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </ScrollViewer>
                      </DockPanel>
                    </Border>
                  </Grid>
                </Border>
              </Grid>
              <Border x:Name="PanelSimpleSetup" Visibility="Collapsed"
                      CornerRadius="4" ClipToBounds="True"
                      Background="{StaticResource SurfaceSunken}">
                <Grid>
                  <Image Source="Assets/install-bg.jpg" Stretch="UniformToFill"
                         VerticalAlignment="Top" HorizontalAlignment="Right"
                         RenderOptions.BitmapScalingMode="HighQuality"/>
                  <!-- Source art is far brighter than the theme; three scrims pull it
                       down to WindowBg and clear the bottom-left copy zone. -->
                  <Border Background="#660B100D"/>
                  <Border>
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#F20B100D" Offset="0"/>
                        <GradientStop Color="#C20B100D" Offset="0.38"/>
                        <GradientStop Color="#000B100D" Offset="0.86"/>
                      </LinearGradientBrush>
                    </Border.Background>
                  </Border>
                  <Border>
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#000B100D" Offset="0"/>
                        <GradientStop Color="#800B100D" Offset="0.42"/>
                        <GradientStop Color="#FA0B100D" Offset="0.88"/>
                      </LinearGradientBrush>
                    </Border.Background>
                  </Border>

                  <ScrollViewer x:Name="ScrollSimpleSetup"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled"
                                PanningMode="VerticalOnly">
                    <Grid MinHeight="{Binding ViewportHeight, ElementName=ScrollSimpleSetup}">
                      <!-- Fixed width: the progress card must not resize as file
                           names and byte counts change under it. -->
                      <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                  Width="600" Margin="40,28,40,32">
                        <TextBlock x:Name="TxtSimpleSetupKicker" Text="{loc:T get_started}"
                                   Style="{StaticResource SectionLabel}"
                                   Foreground="{StaticResource AccentBright}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TxtSimpleSetupTitle" Text="{loc:T install_the_game}"
                                   FontSize="34" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"/>

                        <StackPanel x:Name="PanelSimpleSetupIdle">
                          <TextBlock x:Name="TxtSimpleSetupBlurb" Margin="0,8,0,16" FontSize="14" LineHeight="20"
                                     Foreground="{StaticResource TextSecondary}"
                                     TextWrapping="Wrap"
                                     Text="{loc:T setup_blurb}"/>
                          <TextBlock Text="{loc:T label_language}" Style="{StaticResource FieldLabel}"/>
                          <ComboBox x:Name="CmbUiLanguageSetup"
                                    Style="{StaticResource DarkCombo}"
                                    Height="38" Margin="0,4,0,16"
                                    DisplayMemberPath="Label"
                                    SelectionChanged="OnUiLanguageChanged"/>
                          <TextBlock Text="{loc:T label_folder}" Style="{StaticResource FieldLabel}"/>
                          <DockPanel Margin="0,4,0,12">
                            <Button DockPanel.Dock="Right" Content="{loc:T browse}" Width="112" Height="38"
                                    Margin="10,0,0,0" Style="{StaticResource GhostButton}"
                                    Click="OnBrowseSimpleInstall"/>
                            <TextBox x:Name="TxtSimpleInstallRoot" Height="38"
                                     LostFocus="OnSimpleInstallRootLostFocus"/>
                          </DockPanel>
                          <TextBlock x:Name="TxtSimpleInstallSize" FontSize="13"
                                     Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                                     Text="{loc:T checking_size}"/>
                          <Button x:Name="BtnSimpleSetupInstall"
                                  Style="{StaticResource PlayBarButton}"
                                  Content="{loc:T install}"
                                  HorizontalAlignment="Left"
                                  Margin="0,20,0,0"
                                  Click="OnPlay"/>
                        </StackPanel>

                        <Border x:Name="PanelSimpleInstallProgress" Visibility="Collapsed"
                                Margin="0,18,0,0" Background="#D90C1210"
                                BorderBrush="{StaticResource BorderLine}" BorderThickness="1"
                                CornerRadius="4" Padding="18,16">
                          <StackPanel>
                            <DockPanel>
                              <TextBlock x:Name="TxtSimpleProgressBytes" DockPanel.Dock="Right"
                                         FontSize="12" Foreground="{StaticResource TextSecondary}"
                                         Margin="12,0,0,0" VerticalAlignment="Center"/>
                              <TextBlock x:Name="TxtSimpleProgressPhase"
                                         FontSize="16" FontWeight="SemiBold"
                                         Foreground="{StaticResource AccentBright}" Text="{loc:T working_ellipsis}"/>
                            </DockPanel>
                            <!-- MinHeight on both variable rows: an empty line must not
                                 shrink the card between progress ticks. -->
                            <TextBlock x:Name="TxtSimpleProgressFile"
                                       FontSize="13" Foreground="{StaticResource TextPrimary}"
                                       Margin="0,6,0,0" MinHeight="17"
                                       HorizontalAlignment="Stretch"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"/>
                            <ProgressBar x:Name="BarSimpleFile" Height="8" Minimum="0" Maximum="100"
                                         Margin="0,12,0,0"/>
                            <ItemsControl x:Name="ListActiveTransfers" Margin="0,10,0,0"
                                          Visibility="Collapsed">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="*"/>
                                      <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondary}"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Detail}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondary}"
                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    <ProgressBar Grid.ColumnSpan="2" Height="2"
                                                 Minimum="0" Maximum="100"
                                                 Value="{Binding Percent, Mode=OneWay}"
                                                 VerticalAlignment="Bottom"
                                                 Opacity="0.75"/>
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="0,8,0,0" MinHeight="16">
                              <TextBlock x:Name="TxtSimpleProgressRate" DockPanel.Dock="Right"
                                         FontSize="12" Foreground="{StaticResource AccentBright}"
                                         Margin="12,0,0,0"/>
                              <TextBlock x:Name="TxtSimpleProgressStep"
                                         FontSize="12" Foreground="{StaticResource TextSecondary}"
                                         TextWrapping="NoWrap"
                                         TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <CheckBox x:Name="ChkHdTexturesInstall" Margin="0,10,0,0"
                                      Content="{loc:T hd_textures}"

                        Visibility="Collapsed" Click="OnChangeMap"/>
                <TextBlock x:Name="TxtPlaylistSource" VerticalAlignment="Center"
                           Style="{StaticResource MonoNote}"/>
              </DockPanel>

              <TextBlock x:Name="TxtPlaylistDetail" Style="{StaticResource MonoNote}"
                         Margin="0,0,0,12"/>

              <CheckBox x:Name="ChkDediDeveloper" Content="{loc:T developer}"
                        Margin="0,0,0,8"
                        ToolTip="{loc:T tip_developer_dedi}"
                        Checked="OnDediDeveloperChanged"
                        Unchecked="OnDediDeveloperChanged"/>
              <CheckBox x:Name="ChkDediOnline" Content="{loc:T host_online}"
                        Margin="0,0,0,8"
                        ToolTip="{loc:T tip_host_online}"
                        Checked="OnDediHostOnlineChanged"
                        Unchecked="OnDediHostOnlineChanged"/>
              <CheckBox x:Name="ChkDediPassword" Content="{loc:T lock_server}"
                        Margin="0,0,0,8"
                        ToolTip="{loc:T tip_sv_password}"
                        Checked="OnPasswordProtectChanged"
                        Unchecked="OnPasswordProtectChanged"/>
              <PasswordBox x:Name="TxtDediPassword" Height="32" Margin="0,0,0,12"
                           Visibility="Collapsed"
                           ToolTip="{loc:T tip_password_charset}"
                           PasswordChanged="OnDediPasswordChanged"
                           LostFocus="OnDediPasswordLostFocus"/>

              <Border Background="{StaticResource SurfaceSunken}" CornerRadius="4"
                      Padding="12,8" Margin="0,0,0,12"
                      ToolTip="{loc:T tip_mods_policy}">
                <StackPanel>
                  <TextBlock Text="{loc:T mods_policy}" Style="{StaticResource SectionLabel}"/>
                  <ComboBox x:Name="CmbModPolicy" Height="32" Margin="0,0,0,10"
                            Style="{StaticResource DarkCombo}"
                            SelectionChanged="OnDediModPolicyChanged">
                    <ComboBoxItem Content="{loc:T mods_policy_off}"/>
                    <ComboBoxItem Content="{loc:T mods_policy_required}"/>
                    <ComboBoxItem Content="{loc:T mods_policy_allowlist}"/>
                  </ComboBox>
                  <ItemsControl x:Name="ListDediModPolicy"
                                ItemTemplate="{StaticResource DediModPolicyRowTemplate}"/>
                </StackPanel>
              </Border>

              <TextBlock Text="{loc:T label_extra_args}" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="TxtDediArgs" FontFamily="Consolas" FontSize="12" Margin="0,0,0,6"
                       LostFocus="OnArgsLostFocus" TextChanged="OnArgsTextChanged"/>
              <TextBlock x:Name="TxtDediPreview" Style="{StaticResource MonoNote}"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Background="{StaticResource SurfaceSunken}"
                  Padding="14,12" MinHeight="150">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="{loc:T section_log}" Style="{StaticResource SectionLabel}"/>
              <TextBox x:Name="TxtLog" IsReadOnly="True" TextWrapping="Wrap"
                       Style="{StaticResource PlainTextBox}"
                       VerticalScrollBarVisibility="Auto"
                       Foreground="{StaticResource TextCode}"
                       FontFamily="Consolas" FontSize="12"
                       MinHeight="120"/>
            </DockPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    </DockPanel>

    <!-- Window edge, so the frame reads against a dark desktop. Overlay, not a
         real border: it must not shift layout or shadow the resize grip. -->
    <Border Grid.Row="0" Grid.RowSpan="2"
            BorderBrush="{StaticResource WindowEdge}" BorderThickness="1"
            IsHitTestVisible="False"/>
  </Grid>
</Window>

                   Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
        <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource TextSecondary}"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

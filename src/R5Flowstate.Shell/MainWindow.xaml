              Tag="{Binding Url}" MouseLeftButtonUp="OnCreditRowClick"
              ToolTip="{Binding Url, Mode=OneWay}">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLine}"/>
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel VerticalAlignment="Top">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding By, Mode=OneWay}"
                       FontSize="12" Margin="10,1,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="15" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>

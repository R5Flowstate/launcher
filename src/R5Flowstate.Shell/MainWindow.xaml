  <Grid x:Name="RootChrome">
    <Grid.RowDefinitions>
      <RowDefinition Height="76"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- One header row: drag surface, brand, tabs, build switch and window controls. -->
    <Border x:Name="BarSimpleTabs" Grid.Row="0" Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1"
            MouseLeftButtonDown="OnCaptionMouseDown">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource CaptionButton}" Height="75" Width="46"
                  Content="&#xE921;" Click="OnWinMinimize" ToolTip="{loc:T minimize}"/>
          <Button x:Name="BtnWinMaximize" Style="{StaticResource CaptionButton}" Height="75" Width="46"
                  Click="OnWinMaximize" ToolTip="{loc:T maximize}">
            <TextBlock x:Name="TxtWinMaxGlyph" Text="&#xE922;"/>
          </Button>
          <Button Style="{StaticResource CaptionCloseButton}" Height="75" Width="46"
                  Content="&#xE8BB;" Click="OnWinClose" ToolTip="{loc:T close}"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,6,0">
          <Button x:Name="BtnBrowserRefresh"
                  Style="{StaticResource GhostButton}"
                  Width="34" Height="32" Padding="0" Margin="0,0,6,0"
                  FontFamily="Segoe MDL2 Assets" FontSize="13" Content="&#xE72C;"
                  Visibility="Collapsed"
                  Click="OnBrowserRefresh"
                  ToolTip="{loc:T tip_refresh_servers}"/>
          <Button x:Name="BtnTabToolSettings"
                  Style="{StaticResource GhostButton}"
                  Width="36" Height="32" Padding="0"
                  Click="OnSimpleTabSettings"
                  ToolTip="{loc:T tip_settings}">
            <Viewbox Width="16" Height="16">
              <Canvas Width="16" Height="16">
                <Line X1="1" Y1="4" X2="15" Y2="4"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Line X1="1" Y1="8" X2="15" Y2="8"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Line X1="1" Y1="12" X2="15" Y2="12"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Ellipse Canvas.Left="9.2" Canvas.Top="2.2" Width="3.6" Height="3.6"
                         Fill="{DynamicResource WindowBg}"
                         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                         StrokeThickness="1.5"/>
                <Ellipse Canvas.Left="3.2" Canvas.Top="6.2" Width="3.6" Height="3.6"
                         Fill="{DynamicResource WindowBg}"
                         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                         StrokeThickness="1.5"/>
                <Ellipse Canvas.Left="8.2" Canvas.Top="10.2" Width="3.6" Height="3.6"
                         Fill="{DynamicResource WindowBg}"
                         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"

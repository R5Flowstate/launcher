<Window x:Class="R5Flowstate.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:R5Flowstate.Shell"
        xmlns:loc="clr-namespace:R5Flowstate.Shell"
        Title="R5Flowstate"
        Icon="Assets/app.ico"
        Height="737" Width="1099"
        MinHeight="640" MinWidth="1080"
        Background="{StaticResource WindowBg}" Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        PreviewKeyDown="OnWindowPreviewKeyDown">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0"
                  ResizeBorderThickness="6"
                  GlassFrameThickness="0"
                  CornerRadius="0"
                  UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <local:PingTierBrushConverter x:Key="PingBrush"/>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>

    <DataTemplate x:Key="ServerRowTemplate">
      <Border Background="{StaticResource SurfaceBg}"
              CornerRadius="4" Padding="14,11" Margin="0,0,0,8">
        <DockPanel>
          <Button DockPanel.Dock="Left"
                  Style="{StaticResource FavoriteStar}"
                  Content="{Binding FavoriteGlyph}"
                  Tag="{Binding}"
                  VerticalAlignment="Center" Margin="0,0,12,0"
                  Click="OnToggleFavorite"
                  ToolTip="{loc:T tip_favorite}"/>
          <Button DockPanel.Dock="Right"
                  Style="{StaticResource AccentButton}"
                  Content="{Binding JoinCaption}"
                  Width="84" Height="34" Margin="14,0,0,0"
                  VerticalAlignment="Center"
                  IsEnabled="{Binding JoinEnabled}"
                  ToolTip="{Binding JoinHint}"
                  Tag="{Binding}"
                  Click="OnJoinServerClick"/>
          <TextBlock DockPanel.Dock="Right" Text="{Binding PingLabel}"
                     VerticalAlignment="Center" Margin="12,0,0,0"
                     MinWidth="58" TextAlignment="Right"
                     FontFamily="Consolas" FontSize="12"
                     Foreground="{Binding PingTier, Converter={StaticResource PingBrush}}"/>
          <StackPanel VerticalAlignment="Center">
            <DockPanel>
              <Viewbox DockPanel.Dock="Left" Width="12" Height="12" Margin="0,1,7,0"
                       VerticalAlignment="Center"
                       Visibility="{Binding HasPassword, Converter={StaticResource BoolVis}}"
                       ToolTip="{loc:T tip_password}">
                <Path Fill="{StaticResource TextSecondary}" Stretch="Uniform"
                      Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
              </Viewbox>
              <Border DockPanel.Dock="Left" Margin="0,0,8,0" Padding="6,1" CornerRadius="3"
                      Background="{StaticResource AccentDim}" VerticalAlignment="Center"
                      Visibility="{Binding HasModRequirement, Converter={StaticResource BoolVis}}"
                      ToolTip="{Binding ModTooltip}">
                <TextBlock Text="{Binding ModBadge}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBright}"/>
              </Border>
              <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                         Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <TextBlock Text="{Binding Detail}" FontSize="12"
                       Margin="0,3,0,0" Foreground="{StaticResource TextMuted}"
                       TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="ModRowTemplate">
      <Border Background="{StaticResource SurfaceBg}"
              CornerRadius="4" Padding="14,11" Margin="0,0,0,8">
        <DockPanel>
          <Button DockPanel.Dock="Right"
                  Style="{StaticResource DangerButtonSmall}"
                  Content="{loc:T mods_uninstall}"
                  MinWidth="88" Height="30" Margin="8,0,0,0"
                  VerticalAlignment="Center"
                  IsEnabled="{Binding ActionsEnabled}"
                  Tag="{Binding}"
                  Click="OnModUninstall"/>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                      VerticalAlignment="Center" Margin="8,0,0,0">
            <Button Content="&#x25B2;" Width="30" Height="28" MinWidth="0"
                    Padding="0" FontSize="10" Margin="0,0,4,0"
                    Style="{StaticResource GhostButton}"
                    IsEnabled="{Binding ActionsEnabled}"
                    Tag="{Binding}" Click="OnModMoveUp"
                    ToolTip="{loc:T mods_move_up}"/>
            <Button Content="&#x25BC;" Width="30" Height="28" MinWidth="0"
                    Padding="0" FontSize="10"
                    Style="{StaticResource GhostButton}"
                    IsEnabled="{Binding ActionsEnabled}"
                    Tag="{Binding}" Click="OnModMoveDown"
                    ToolTip="{loc:T mods_move_down}"/>
          </StackPanel>
          <CheckBox DockPanel.Dock="Right"
                    Style="{StaticResource QuietCheck}"
                    Margin="10,0,0,0" VerticalAlignment="Center"
                    IsChecked="{Binding Enabled, Mode=OneWay}"
                    IsEnabled="{Binding ActionsEnabled}"
                    Tag="{Binding}"
                    Checked="OnModEnabledChanged"
                    Unchecked="OnModEnabledChanged"
                    ToolTip="{loc:T mods_enable}"/>
          <Grid DockPanel.Dock="Left" Width="36" Height="36" Margin="0,0,12,0"
                VerticalAlignment="Center">
            <Image Source="Assets/logo.png" Opacity="0.28" Stretch="Uniform"
                   IsHitTestVisible="False"/>
            <Image Source="{Binding IconSource}" Stretch="UniformToFill">
              <Image.Style>
                <Style TargetType="Image">
                  <Setter Property="Visibility" Value="Visible"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasIcon}" Value="False">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Image.Style>
            </Image>
          </Grid>
          <StackPanel VerticalAlignment="Center">
            <DockPanel>
              <Border DockPanel.Dock="Right" Margin="8,0,0,0" Padding="6,1" CornerRadius="3"
                      Background="{StaticResource UpdateFill}" VerticalAlignment="Center"
                      Visibility="{Binding HasUpdate, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding UpdateLabel}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource UpdateText}"/>
              </Border>
              <Border DockPanel.Dock="Right" Margin="8,0,0,0" Padding="6,1" CornerRadius="3"
                      Background="{StaticResource DangerBg}" VerticalAlignment="Center"
                      Visibility="{Binding HasWarning, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding WarningLabel}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource DangerFg}"/>
              </Border>
              <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                         Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <TextBlock Text="{Binding Detail}" FontSize="12"
                       Margin="0,3,0,0" Foreground="{StaticResource TextMuted}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding ProgressText}" FontSize="11"
                       Margin="0,3,0,0" Foreground="{StaticResource AccentBright}"
                       Visibility="{Binding HasProgress, Converter={StaticResource BoolVis}}"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="BrowseModRowTemplate">
      <Border Background="{StaticResource SurfaceBg}"
              CornerRadius="4" Padding="14,11" Margin="0,0,0,8">
        <DockPanel>
          <Button DockPanel.Dock="Right"
                  Style="{StaticResource AccentButton}"
                  Content="{Binding InstallCaption}"
                  Width="96" Height="34" Margin="14,0,0,0"
                  VerticalAlignment="Center"
                  IsEnabled="{Binding InstallEnabled}"
                  Tag="{Binding}"
                  Click="OnBrowseModInstall"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Detail}" FontSize="12"
                       Margin="0,3,0,0" Foreground="{StaticResource TextMuted}"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ProgressText}" FontSize="11"
                       Margin="0,3,0,0" Foreground="{StaticResource AccentBright}"
                       Visibility="{Binding HasProgress, Converter={StaticResource BoolVis}}"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="DediModPolicyRowTemplate">
      <DockPanel Margin="0,0,0,6">
        <ComboBox DockPanel.Dock="Right" Width="140" Height="28"
                  Style="{StaticResource DarkCombo}"
                  SelectedIndex="{Binding PolicyIndex, Mode=OneWay}"
                  Tag="{Binding}"
                  SelectionChanged="OnDediModRowPolicyChanged">
          <ComboBoxItem Content="{loc:T mods_policy_choice_off}"/>
          <ComboBoxItem Content="{loc:T mods_policy_choice_req}"/>
          <ComboBoxItem Content="{loc:T mods_policy_choice_allow}"/>
        </ComboBox>
        <TextBlock Text="{Binding Name}" FontSize="13"
                   Foreground="{StaticResource TextPrimary}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Margin="0,0,10,0"/>
      </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="PatchNoteRowTemplate">
      <Border BorderBrush="{StaticResource BorderLine}" BorderThickness="2,0,0,0"
              Background="Transparent" Padding="16,12,16,14" Margin="0,0,0,16">
        <StackPanel>
          <DockPanel Margin="0,0,0,2">
            <TextBlock DockPanel.Dock="Right" FontSize="12" Foreground="{StaticResource TextMuted}"
                       VerticalAlignment="Center" Margin="12,0,0,0"
                       Text="{Binding Date, Mode=OneWay}"/>
            <TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <Rectangle Height="1" Fill="{StaticResource BorderSoft}" Margin="0,8,0,0"/>
          <ItemsControl ItemsSource="{Binding Items}" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,0,0,6">
                  <Rectangle x:Name="Bullet"
                             DockPanel.Dock="Left" Width="5" Height="5" RadiusX="1" RadiusY="1"
                             Margin="1,6,10,0" VerticalAlignment="Top"
                             Fill="{StaticResource Accent}"/>
                  <TextBlock x:Name="Line" Text="{Binding Text, Mode=OneWay}" FontSize="13"
                             Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                </DockPanel>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsHeader, Mode=OneWay}" Value="True">
                    <Setter TargetName="Bullet" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Line" Property="FontWeight" Value="SemiBold"/>
                    <Setter TargetName="Line" Property="Foreground" Value="{StaticResource TextPrimary}"/>
                    <Setter TargetName="Line" Property="Margin" Value="0,10,0,2"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="BlogCardTemplate">
      <Border x:Name="Card" CornerRadius="10" Margin="0,0,0,10" Cursor="Hand" ClipToBounds="True"
              Tag="{Binding}" MouseLeftButtonUp="OnBlogCardClick" KeyDown="OnBlogCardKey"
              Focusable="True" ToolTip="{Binding Title, Mode=OneWay}">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel>
          <Border Height="170" ClipToBounds="True" Background="{StaticResource SurfaceSunken}"
                  Visibility="{Binding HasCover, Converter={StaticResource BoolVis}}">
            <Grid>
              <TextBlock Text="R5" FontSize="22" FontWeight="Bold"
                         Foreground="{StaticResource AccentTrack}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Image Source="{Binding CoverImage}" Stretch="UniformToFill"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     SnapsToDevicePixels="True"
                     Visibility="{Binding HasCoverImage, Converter={StaticResource BoolVis}}"/>
            </Grid>
          </Border>
          <StackPanel Margin="20,14,20,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
              <Border Padding="8,2" CornerRadius="4" Margin="0,0,8,0"
                      Background="{StaticResource AccentDim}"
                      Visibility="{Binding HasTag, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding Tag, Mode=OneWay}" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBright}" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="{Binding Date, Mode=OneWay}" FontSize="11"
                         Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="17" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" TextAlignment="Center"
                       MaxHeight="42" TextTrimming="WordEllipsis"/>
            <TextBlock Text="{Binding Summary, Mode=OneWay}" FontSize="12.5" Margin="0,6,0,0"
                       Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" TextAlignment="Center"
                       MaxHeight="30" TextTrimming="WordEllipsis"
                       Visibility="{Binding HasSummary, Converter={StaticResource BoolVis}}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <Style x:Key="LbSort" TargetType="Button" BasedOn="{StaticResource GhostButton}">
      <Setter Property="Height" Value="26"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
      <Setter Property="HorizontalContentAlignment" Value="Right"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <DataTemplate x:Key="LeaderboardRowTemplate">
      <Border CornerRadius="4" Padding="12,9" Margin="0,0,0,6" Cursor="Hand"
              Tag="{Binding}" MouseLeftButtonUp="OnLeaderboardRowClick"
              ToolTip="{Binding Persona}">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBg}"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentDim}"/>
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
              </Trigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsSelected}" Value="True"/>
                  <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource AccentDim}"/>
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid MinWidth="1024">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="52"/>
            <ColumnDefinition Width="*" MinWidth="120"/>
            <ColumnDefinition Width="58"/>
            <ColumnDefinition Width="36"/>
            <ColumnDefinition Width="36"/>
            <ColumnDefinition Width="46"/>
            <ColumnDefinition Width="54"/>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="76"/>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="36"/>
            <ColumnDefinition Width="44"/>
            <ColumnDefinition Width="44"/>
            <ColumnDefinition Width="48"/>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="44"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{Binding RankLabel}" FontFamily="Consolas" FontSize="12"
                     TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsPodium}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentBright}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Grid.Column="1" Text="{Binding Persona}" FontSize="13" FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" Margin="4,0,8,0"/>
          <TextBlock Grid.Column="2" Text="{Binding ScoreLabel}" FontFamily="Consolas" FontSize="12"
                     Foreground="{StaticResource TextPrimary}" TextAlignment="Right" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="3" Text="{Binding KillsLabel}" FontFamily="Consolas" FontSize="12"
                     Foreground="{StaticResource TextSecondary}" TextAlignment="Right" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="4" Text="{Binding DeathsLabel}" FontFamily="Consolas" FontSize="12"
                     Foreground="{StaticResource TextSecondary}" TextAlignment="Right" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="5" Text="{Binding KdLabel}" FontFamily="Consolas" FontSize="12"
                     Foreground="{StaticResource TextPrimary}" TextAlignment="Right" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="6" Text="{Binding DamageLabel}" FontFamily="Consolas" FontSize="12"
                     Foreground="{StaticResource TextSecondary}" TextAlignment="Right" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="7" Text="{Binding AccLabel}" FontFamily="Consolas" FontSize="12"
                     Foreground="{StaticResource TextSecondary}" TextAlignment="Right" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="8" Text="{Binding WeaponLabel}" FontSize="12"
                     Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" Margin="8,0,4,0"/>
          <TextBlock Grid.Column="9" Text="{Binding InputLabel}" FontFamily="Consolas" FontSize="11"
                     Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="4,0,0,0"/>
          <TextBlock Grid.Column="10" Text="{Binding HsLabel}" FontFamily="Consolas" FontSize="12"
                     Foreground="{StaticResource TextSecondary}" TextAlignment="Right" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="11" Text="{Binding HitsLabel}" FontFamily="Consolas" FontSize="12"
                     Foreground="{StaticResource TextSecondary}" TextAlignment="Right" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="12" Text="{Binding WinsLabel}" FontFamily="Consolas" FontSize="12"
                     Foreground="{StaticResource TextSecondary}" TextAlignment="Right" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="13" Text="{Binding GamesLabel}" FontFamily="Consolas" FontSize="12"
                     Foreground="{StaticResource TextSecondary}" TextAlignment="Right" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="14" Text="{Binding WrLabel}" FontFamily="Consolas" FontSize="12"
                     Foreground="{StaticResource TextPrimary}" TextAlignment="Right" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="15" Text="{Binding StreakLabel}" FontFamily="Consolas" FontSize="12"
                     Foreground="{StaticResource TextSecondary}" TextAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="LbMatchRowTemplate">
      <DockPanel Margin="0,0,0,6" Background="Transparent" Cursor="Hand"
                 Tag="{Binding}" MouseLeftButtonUp="OnLbRecentMatchClick"
                 ToolTip="{loc:T lb_match_open}">
        <TextBlock DockPanel.Dock="Left" Text="{Binding Result}" FontFamily="Consolas"
                   FontWeight="SemiBold" FontSize="13" MinWidth="22" VerticalAlignment="Center">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsWin}" Value="True">
                  <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLoss}" Value="True">
                  <Setter Property="Foreground" Value="{StaticResource DangerLine}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <TextBlock DockPanel.Dock="Right" Text="{Binding AtLabel}" FontSize="11"
                   Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
        <TextBlock DockPanel.Dock="Right" Text="{Binding HostLabel}" FontSize="11"
                   Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" MinWidth="72"
                   TextTrimming="CharacterEllipsis" Margin="12,0,0,0"/>
        <TextBlock DockPanel.Dock="Right" Text="{Binding DurationLabel}" FontFamily="Consolas" FontSize="12"
                   Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" MinWidth="36"
                   TextAlignment="Right" Margin="12,0,0,0"/>
        <TextBlock DockPanel.Dock="Right" Text="{Binding DamageLabel}" FontFamily="Consolas" FontSize="12"
                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" MinWidth="48"
                   TextAlignment="Right" Margin="12,0,0,0"/>
        <TextBlock DockPanel.Dock="Right" Text="{Binding KdLabel}" FontFamily="Consolas" FontSize="12"
                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" MinWidth="40"
                   TextAlignment="Right" Margin="12,0,0,0"/>
        <TextBlock>
          <Run Text="{loc:T vs}" Foreground="{StaticResource TextMuted}"/>
          <Run Text="{Binding Opponent, Mode=OneWay}" Foreground="{StaticResource TextPrimary}"/>
          <Run Text="  ·  " Foreground="{StaticResource TextMuted}"/>
          <Run Text="{Binding MapLabel, Mode=OneWay}" Foreground="{StaticResource TextSecondary}"/>
          <Run Text="  ·  " Foreground="{StaticResource TextMuted}"/>
          <Run Text="{Binding WeaponLabel, Mode=OneWay}" Foreground="{StaticResource TextMuted}"/>
        </TextBlock>
      </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="LbHistoryRowTemplate">
      <Border Background="{StaticResource SurfaceBg}" CornerRadius="4" Padding="12,10" Margin="0,0,0,6"
              Tag="{Binding}" Cursor="Hand" MouseLeftButtonUp="OnLbHistoryRowClick"
              ToolTip="{loc:T lb_match_open}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Text="{Binding ScoreLabel}" FontFamily="Consolas"
                     FontWeight="SemiBold" FontSize="14" MinWidth="56" VerticalAlignment="Center"
                     Foreground="{StaticResource AccentBright}"/>
          <TextBlock DockPanel.Dock="Right" Text="{Binding AtLabel}" FontSize="11"
                     Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
          <TextBlock DockPanel.Dock="Right" Text="{Binding HostLabel}" FontSize="11"
                     Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" MinWidth="72"
                     TextTrimming="CharacterEllipsis" Margin="12,0,0,0"/>
          <TextBlock DockPanel.Dock="Right" Text="{Binding DurationLabel}" FontFamily="Consolas" FontSize="12"
                     Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" MinWidth="36"
                     TextAlignment="Right" Margin="12,0,0,0"/>
          <TextBlock DockPanel.Dock="Right" Text="{Binding DamageLabel}" FontFamily="Consolas" FontSize="12"
                     Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" MinWidth="56"
                     TextAlignment="Right" Margin="12,0,0,0"/>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                       FontSize="13" Foreground="{StaticResource TextPrimary}"/>
            <TextBlock FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
              <Run Text="{Binding MapLabel, Mode=OneWay}" Foreground="{StaticResource TextSecondary}"/>
              <Run Text="  &#183;  " Foreground="{StaticResource TextMuted}"/>
              <Run Text="{Binding PlaylistLabel, Mode=OneWay}" Foreground="{StaticResource TextMuted}"/>
            </TextBlock>
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="MatchPlayerRowTemplate">
      <Border Background="{StaticResource SurfaceRaised}" CornerRadius="4" Padding="12,10" Margin="0,0,0,6"
              Tag="{Binding}" Cursor="Hand" MouseLeftButtonUp="OnMatchPlayerClick"
              ToolTip="{loc:T lb_match_open_player}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Text="{Binding Result}" FontFamily="Consolas"
                     FontWeight="SemiBold" FontSize="13" MinWidth="26" VerticalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsWin}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsLoss}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DangerLine}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding KillsLabel}" FontFamily="Consolas" FontSize="12" MinWidth="34"
                       TextAlignment="Right" Foreground="{StaticResource TextPrimary}"/>
            <TextBlock Text="{Binding DeathsLabel}" FontFamily="Consolas" FontSize="12" MinWidth="34"
                       TextAlignment="Right" Foreground="{StaticResource TextSecondary}"/>
            <TextBlock Text="{Binding DamageLabel}" FontFamily="Consolas" FontSize="12" MinWidth="56"
                       TextAlignment="Right" Foreground="{StaticResource TextSecondary}"/>
            <TextBlock Text="{Binding HsLabel}" FontFamily="Consolas" FontSize="12" MinWidth="34"
                       TextAlignment="Right" Foreground="{StaticResource TextMuted}"/>
            <TextBlock Text="{Binding HitsLabel}" FontFamily="Consolas" FontSize="12" MinWidth="42"
                       TextAlignment="Right" Foreground="{StaticResource TextMuted}"/>
            <TextBlock Text="{Binding AccLabel}" FontFamily="Consolas" FontSize="12" MinWidth="52"
                       TextAlignment="Right" Foreground="{StaticResource TextMuted}"/>
          </StackPanel>
          <StackPanel Margin="6,0,12,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Persona}" FontSize="13" TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource TextPrimary}"/>

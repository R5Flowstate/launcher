                  </Button>
                  <Button x:Name="BtnTabNotes"
                          Style="{StaticResource TabButton}" Click="OnSimpleTabNotes">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{loc:T tab_notes}" VerticalAlignment="Center"/>
                      <Ellipse x:Name="DotNotesUnread" Width="7" Height="7"
                               Margin="7,0,0,1" VerticalAlignment="Center"
                               Fill="{StaticResource Accent}" Visibility="Collapsed"/>
                    </StackPanel>
                  </Button>
                  <Button x:Name="BtnTabCredits" Content="{loc:T tab_credits}" Margin="0"
                          Style="{StaticResource TabButton}" Click="OnSimpleTabCredits"/>

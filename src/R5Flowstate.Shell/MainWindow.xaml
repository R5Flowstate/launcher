                    <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Left">
                      <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnCmdServer" Style="{StaticResource RingSegment}" Content="{loc:T adv_server}" Click="OnCommandSegmentClick"/>
                        <Button x:Name="BtnCmdClient" Style="{StaticResource RingSegment}" Content="{loc:T adv_client}" Click="OnCommandSegmentClick"/>
                      </StackPanel>
                    </Border>
                  </DockPanel>
                  <Border CornerRadius="8" Background="{DynamicResource SurfaceSunken}" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <Grid>
                        <TextBlock x:Name="TxtDediPreview" Style="{StaticResource MonoNote}"/>
                        <TextBlock x:Name="TxtClientPreview" Style="{StaticResource MonoNote}" Visibility="Collapsed"/>
                      </Grid>
                    </ScrollViewer>
                  </Border>
                </DockPanel>
              </Border>
            </DockPanel>
          </Grid>
          </Grid>
        </Grid>
      </DockPanel>
    </Grid>
    </DockPanel>

    <Border x:Name="BuildFlash" Grid.Row="0" Grid.RowSpan="2" Opacity="0" IsHitTestVisible="False"
            Background="{DynamicResource Accent}"/>

    <!-- Window edge, so the frame reads against a dark desktop. Overlay, not a
         real border: it must not shift layout or shadow the resize grip. -->
    <Border Grid.Row="0" Grid.RowSpan="2"
            BorderBrush="{DynamicResource WindowEdge}" BorderThickness="1"
            IsHitTestVisible="False"/>
  </Grid>
</Window>

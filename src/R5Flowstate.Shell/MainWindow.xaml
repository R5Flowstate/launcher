              </ScrollViewer>
            </DockPanel>
          </DockPanel>
        </Border>
        <TextBlock x:Name="TxtBrowserStatus" DockPanel.Dock="Top" Text="" FontSize="12"
                   Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                   Background="{StaticResource SurfaceBg}"
                   Padding="16,12,16,0" Visibility="Collapsed"/>
        <Border x:Name="BarSimpleFooter" DockPanel.Dock="Bottom" Margin="0"
                Padding="16,8" Background="{StaticResource WindowBg}"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                      Margin="16,0,0,0">
            <Button Style="{StaticResource FooterIcon}" Click="OnOpenWebsite" ToolTip="{loc:T tip_website}">
              <Viewbox Width="15" Height="15">
                <Canvas Width="16" Height="16">
                  <Ellipse Canvas.Left="0.8" Canvas.Top="0.8" Width="14.4" Height="14.4"
                           Stroke="{StaticResource TextSecondary}" StrokeThickness="1.4"/>
                  <Ellipse Canvas.Left="4.9" Canvas.Top="0.8" Width="6.2" Height="14.4"
                           Stroke="{StaticResource TextSecondary}" StrokeThickness="1.2"/>
                  <Line X1="1.2" Y1="8" X2="14.8" Y2="8"
                        Stroke="{StaticResource TextSecondary}" StrokeThickness="1.2"/>

<Window x:Class="R5Flowstate.Shell.LaunchArgsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:R5Flowstate.Shell"
        Title="{loc:T launch_args_title}"
        Icon="{DynamicResource AppIcon}"
        Width="720" SizeToContent="Height"
        MinWidth="560" MaxHeight="780"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <DockPanel Margin="22,18,22,16">
    <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0" LastChildFill="False">
      <Button DockPanel.Dock="Right" Content="{loc:T close}"
              MinWidth="120" Height="36" IsDefault="True" IsCancel="True"
              Style="{StaticResource AccentButton}" Click="OnClose"/>
    </DockPanel>
    <TextBlock DockPanel.Dock="Top" FontSize="13"
               Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
               Text="{loc:T launch_args_hint_client}" Margin="0,0,0,14"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="{loc:T section_client}" Style="{StaticResource SectionLabel}"/>
          <loc:ArgsEditor x:Name="ClientArgs"/>
        </StackPanel>
      </Border>
    </ScrollViewer>
  </DockPanel>
</Window>

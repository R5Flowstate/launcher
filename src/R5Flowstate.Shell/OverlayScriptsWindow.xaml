<Window x:Class="R5Flowstate.Shell.OverlayScriptsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:R5Flowstate.Shell"
        Title="{loc:T overlay_title}"
        Icon="{DynamicResource AppIcon}"
        SizeToContent="Height" Width="580"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <StackPanel Margin="24,22,24,20">
    <TextBlock FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"
               Text="{loc:T overlay_changed}"/>
    <TextBlock x:Name="TxtDetail" Margin="0,10,0,0" FontSize="13"
               Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
    <Border Margin="0,14,0,0" CornerRadius="8" Padding="14,11"
            Background="{DynamicResource SurfaceSunken}">
      <TextBlock x:Name="TxtSamples" FontFamily="Consolas" FontSize="12"
                 Foreground="{DynamicResource TextCode}" TextWrapping="Wrap"/>
    </Border>
    <TextBlock Margin="0,16,0,0" FontSize="13"
               Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
               Text="{loc:T overlay_body}"/>
    <WrapPanel Margin="0,20,0,0" HorizontalAlignment="Right">
      <Button Content="{loc:T overlay_restore}"
              MinWidth="148" Height="36" Margin="0,0,10,0"
              Style="{StaticResource DangerButtonSmall}" Click="OnRestore"/>
      <Button Content="{loc:T overlay_leave}"
              MinWidth="140" Height="36" Margin="0,0,10,0"
              Style="{StaticResource GhostButton}" Click="OnLeave"/>
      <Button Content="{loc:T overlay_leave_always}"
              MinWidth="200" Height="36"
              IsDefault="True"
              Style="{StaticResource AccentButton}" Click="OnAlways"/>
    </WrapPanel>
  </StackPanel>
</Window>

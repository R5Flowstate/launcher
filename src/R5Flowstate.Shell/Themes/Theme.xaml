<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:R5Flowstate.Shell">

  <!-- ============================ PALETTE ============================ -->

  <ImageSource x:Key="AppIcon">pack://application:,,,/Assets/app.ico</ImageSource>
  <ImageSource x:Key="SetupBackground">pack://application:,,,/Assets/install-bg.jpg</ImageSource>

  <Color x:Key="AccentColor">#45DE91</Color>

  <SolidColorBrush x:Key="WindowBg"      Color="#183226"/>
  <SolidColorBrush x:Key="SurfaceBg"     Color="#1D3A2C"/>
  <SolidColorBrush x:Key="SurfaceRaised" Color="#274C3A"/>
  <SolidColorBrush x:Key="SurfaceSunken" Color="#183024"/>
  <SolidColorBrush x:Key="FieldBg"       Color="#315A46"/>

  <SolidColorBrush x:Key="BorderSoft"    Color="#2C5240"/>
  <SolidColorBrush x:Key="BorderLine"    Color="#376350"/>
  <SolidColorBrush x:Key="BorderStrong"  Color="#4A7A63"/>

  <SolidColorBrush x:Key="TextPrimary"   Color="#F4FBF7"/>
  <SolidColorBrush x:Key="TextSecondary" Color="#D2E2D9"/>
  <SolidColorBrush x:Key="TextMuted"     Color="#B0CABC"/>
  <SolidColorBrush x:Key="TextCode"      Color="#B4CCBF"/>

  <SolidColorBrush x:Key="Accent"        Color="#4DF0A0"/>
  <SolidColorBrush x:Key="WindowEdge"    Color="#1F6141" Opacity="0.60"/>
  <SolidColorBrush x:Key="AccentBright"  Color="#B4F7D2"/>
  <SolidColorBrush x:Key="AccentDim"     Color="#23553D"/>
  <SolidColorBrush x:Key="AccentTrack"   Color="#2C6A4C"/>

  <SolidColorBrush x:Key="PingFair"      Color="#E0C25A"/>

  <SolidColorBrush x:Key="DangerFg"      Color="#F3B7BE"/>
  <SolidColorBrush x:Key="DangerBg"      Color="#2A1418"/>
  <SolidColorBrush x:Key="DangerLine"    Color="#D95060"/>

  <SolidColorBrush x:Key="OverlayLight"  Color="#FFFFFF"/>
  <SolidColorBrush x:Key="OverlayDark"   Color="#000000"/>

  <SolidColorBrush x:Key="PrimaryFill"   Color="#3FE695"/>
  <SolidColorBrush x:Key="PrimaryText"   Color="#05140C"/>
  <SolidColorBrush x:Key="DangerFill"    Color="#C8465A"/>
  <SolidColorBrush x:Key="UpdateFill"    Color="#D4A017"/>
  <SolidColorBrush x:Key="UpdateText"    Color="#1A1404"/>
  <SolidColorBrush x:Key="ChangeFill"    Color="#2E86C8"/>
  <SolidColorBrush x:Key="ChangeText"    Color="#F0F7FF"/>
  <SolidColorBrush x:Key="LeaveFill"     Color="#C87A2E"/>
  <SolidColorBrush x:Key="LeaveText"     Color="#1A0F04"/>
  <SolidColorBrush x:Key="RestartFill"   Color="#7A4FC8"/>
  <SolidColorBrush x:Key="RestartText"   Color="#F4F0FF"/>

  <LinearGradientBrush x:Key="HeaderFill" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#1B2821" Offset="0"/>
    <GradientStop Color="#15201A" Offset="1"/>
  </LinearGradientBrush>

  <SolidColorBrush x:Key="HeroBg"           Color="#183024"/>
  <SolidColorBrush x:Key="HeroTitle"        Color="#F4F7F5"/>
  <SolidColorBrush x:Key="HeroSubtitle"     Color="#E0ECE5"/>
  <SolidColorBrush x:Key="HeroCommand"      Color="#8AA094"/>
  <SolidColorBrush x:Key="HeroChip"         Color="#99183024"/>
  <SolidColorBrush x:Key="HeroChipEdge"     Color="#2EF4F7F5"/>
  <SolidColorBrush x:Key="MapPickerBg"      Color="#F21D3A2C"/>
  <SolidColorBrush x:Key="SetupScrim"       Color="#22101C16"/>
  <SolidColorBrush x:Key="SetupProgressBg"  Color="#D90C1210"/>
  <SolidColorBrush x:Key="ScrollThumb"      Color="#2A4A38"/>
  <SolidColorBrush x:Key="ScrollThumbHover" Color="#3A6A4C"/>
  <SolidColorBrush x:Key="BarTrack"         Color="#1A2420"/>
  <SolidColorBrush x:Key="NoticeBg"         Color="#14281C"/>

  <LinearGradientBrush x:Key="HeroShade" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#00102018" Offset="0"/>
    <GradientStop Color="#B8102018" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="GlassSurface" Color="#A6183024"/>
  <LinearGradientBrush x:Key="PlayFill" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#FF2FD488" Offset="0"/>
    <GradientStop Color="#FF66F7B4" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="SetupScrimLeft" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#CC101C16" Offset="0"/>
    <GradientStop Color="#80101C16" Offset="0.42"/>
    <GradientStop Color="#00101C16" Offset="0.8"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="SetupScrimBottom" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#00101C16" Offset="0.3"/>
    <GradientStop Color="#66101C16" Offset="0.7"/>
    <GradientStop Color="#E6101C16" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="BlogCoverFade" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#E6111815" Offset="0"/>
    <GradientStop Color="#C0111815" Offset="0.5"/>
    <GradientStop Color="#00111815" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="TileFade" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#000B100D" Offset="0"/>
    <GradientStop Color="#E60B100D" Offset="1"/>
  </LinearGradientBrush>

  <!-- ============================ TEXT ============================ -->

  <Style x:Key="SectionLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>

  <Style x:Key="FieldLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    <Setter Property="Margin" Value="0,0,0,4"/>
  </Style>

  <Style x:Key="MonoNote" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Consolas"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{DynamicResource TextCode}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <!-- ============================ CARDS ============================ -->

  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="20,18"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>

  <!-- Hairline divider; the only structural line in the layout. -->
  <Style x:Key="Rule" TargetType="Border">
    <Setter Property="Height" Value="1"/>
    <Setter Property="Background" Value="{DynamicResource BorderSoft}"/>
  </Style>

  <!-- ============================ BUTTONS ============================
       Every variant shares one template. Hover/press are neutral overlays
       so the same template serves accent, danger and neutral fills. -->

  <!-- Replaces the system's dashed focus rectangle on every control; App registers it. -->
  <Style x:Key="SoftFocus">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border CornerRadius="6" Opacity="0.22" IsHitTestVisible="False" Background="#FFFFFFFF"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="BaseButton" TargetType="Button">
    <Setter Property="Height" Value="32"/>
    <Setter Property="Padding" Value="14,0"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4"/>
            <Border x:Name="Sheen" CornerRadius="4" Opacity="0"
                    Background="{DynamicResource OverlayLight}"/>
            <Border x:Name="Press" CornerRadius="4" Opacity="0"
                    Background="{DynamicResource OverlayDark}"/>
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Sheen" Property="Opacity" Value="0.07"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Sheen" Property="Opacity" Value="0"/>
              <Setter TargetName="Press" Property="Opacity" Value="0.18"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.38"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Button" BasedOn="{StaticResource BaseButton}"/>

  <!-- The one solid fill in the app: nothing else competes with it. -->
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Height" Value="48"/>
    <Setter Property="MinWidth" Value="168"/>
    <Setter Property="Padding" Value="24,0"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    <Setter Property="Background" Value="{DynamicResource PrimaryFill}"/>
  </Style>

  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
    <Setter Property="Foreground" Value="#FFF0F2"/>
    <Setter Property="Background" Value="{DynamicResource DangerFill}"/>
  </Style>

  <Style x:Key="DangerButtonSmall" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Foreground" Value="{DynamicResource DangerFg}"/>
    <Setter Property="Background" Value="{DynamicResource DangerBg}"/>
  </Style>

  <Style x:Key="ChangeButtonSmall" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Foreground" Value="{DynamicResource ChangeText}"/>
    <Setter Property="Background" Value="{DynamicResource ChangeFill}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="LeaveButtonSmall" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Foreground" Value="{DynamicResource LeaveText}"/>
    <Setter Property="Background" Value="{DynamicResource LeaveFill}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="RestartButtonSmall" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Foreground" Value="{DynamicResource RestartText}"/>
    <Setter Property="Background" Value="{DynamicResource RestartFill}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="RestartButton" TargetType="Button" BasedOn="{StaticResource RestartButtonSmall}"/>

  <Style x:Key="UpdateButtonSmall" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Foreground" Value="{DynamicResource UpdateText}"/>
    <Setter Property="Background" Value="{DynamicResource UpdateFill}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Foreground" Value="{DynamicResource AccentBright}"/>
    <Setter Property="Background" Value="{DynamicResource AccentDim}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- Borderless-window caption controls. -->
  <Style x:Key="CaptionButton" TargetType="Button">
    <Setter Property="Width" Value="46"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="Cursor" Value="Arrow"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
              <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#F1707A"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    <Setter Property="Background" Value="Transparent"/>
  </Style>

  <!-- Keys read by name from MainWindow.Browser.cs; do not rename.
       BorderBrush drives the underline indicator, not an outline. -->
  <Style x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Height" Value="38"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0,0,22,0"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="Transparent">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="2"/>
            </Grid.RowDefinitions>
            <ContentPresenter Grid.Row="0" Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Border Grid.Row="1" CornerRadius="1"
                    Background="{TemplateBinding BorderBrush}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.38"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- One half of the LIVE | PLAYTEST channel switch; the selected half is filled from code. -->
  <Style x:Key="RingSegment" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Height" Value="26"/>
    <Setter Property="MinWidth" Value="74"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" CornerRadius="4">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TabButtonOn" TargetType="Button" BasedOn="{StaticResource TabButton}">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="ModeChip" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Height" Value="42"/>
    <Setter Property="Margin" Value="4,0"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsSelected}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource AccentBright}"/>
        <Setter Property="Background" Value="{DynamicResource AccentTrack}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="ModeRailGroup" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Consolas"/>
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
  </Style>

  <Style x:Key="ModeRailItem" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="Margin" Value="0,1"/>
    <Setter Property="Padding" Value="9,0"/>
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Bd" CornerRadius="8"
                    Background="{TemplateBinding Background}"/>
            <ContentPresenter x:Name="Body" Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center">
              <ContentPresenter.RenderTransform>
                <TranslateTransform x:Name="BodyShift"/>
              </ContentPresenter.RenderTransform>
            </ContentPresenter>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="BodyShift" Storyboard.TargetProperty="X" To="4" Duration="0:0:0.11"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="BodyShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.13"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FieldBg}"/>
              <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            </Trigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentTrack}"/>
              <Setter Property="Foreground" Value="{DynamicResource AccentBright}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PlayBarButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
    <Setter Property="Height" Value="38"/>
    <Setter Property="Width" Value="Auto"/>
    <Setter Property="MinWidth" Value="132"/>
    <Setter Property="Padding" Value="34,0"/>
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"/>
            <Border x:Name="Sheen" CornerRadius="8" Opacity="0"
                    Background="{DynamicResource OverlayLight}"/>
            <Border x:Name="Press" CornerRadius="8" Opacity="0"
                    Background="{DynamicResource OverlayDark}"/>
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Sheen" Property="Opacity" Value="0.07"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Sheen" Property="Opacity" Value="0"/>
              <Setter TargetName="Press" Property="Opacity" Value="0.18"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.38"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PlayBarDanger" TargetType="Button" BasedOn="{StaticResource PlayBarButton}">
    <Setter Property="Foreground" Value="#FFF0F2"/>
    <Setter Property="Background" Value="{DynamicResource DangerFill}"/>
  </Style>

  <Style x:Key="PlayBarUpdate" TargetType="Button" BasedOn="{StaticResource PlayBarButton}">
    <Setter Property="Foreground" Value="{DynamicResource UpdateText}"/>
    <Setter Property="Background" Value="{DynamicResource UpdateFill}"/>
  </Style>

  <Style x:Key="PlayBarChange" TargetType="Button" BasedOn="{StaticResource PlayBarButton}">
    <Setter Property="Foreground" Value="{DynamicResource ChangeText}"/>
    <Setter Property="Background" Value="{DynamicResource ChangeFill}"/>
  </Style>

  <!-- CHANGE MAP / CHANGE PLAYLIST with a STOP button inside it. -->
  <Style x:Key="PlayBarChangeSplit" TargetType="Button" BasedOn="{StaticResource PlayBarChange}">
    <Setter Property="Padding" Value="34,0,5,0"/>
  </Style>

  <Style x:Key="PlayBarInlineStop" TargetType="Button">
    <Setter Property="Height" Value="28"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="Margin" Value="22,0,0,0"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="#FFF0F2"/>
    <Setter Property="Background" Value="{DynamicResource DangerFill}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border Background="{TemplateBinding Background}" CornerRadius="6"/>
            <Border x:Name="Sheen" CornerRadius="6" Opacity="0"
                    Background="{DynamicResource OverlayLight}"/>
            <Border x:Name="Press" CornerRadius="6" Opacity="0"
                    Background="{DynamicResource OverlayDark}"/>
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Sheen" Property="Opacity" Value="0.12"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Sheen" Property="Opacity" Value="0"/>
              <Setter TargetName="Press" Property="Opacity" Value="0.22"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PlayBarDisconnect" TargetType="Button" BasedOn="{StaticResource PlayBarButton}">
    <Setter Property="Foreground" Value="{DynamicResource LeaveText}"/>
    <Setter Property="Background" Value="{DynamicResource LeaveFill}"/>
  </Style>

  <Style x:Key="PlayBarRestart" TargetType="Button" BasedOn="{StaticResource PlayBarButton}">
    <Setter Property="Foreground" Value="{DynamicResource RestartText}"/>
    <Setter Property="Background" Value="{DynamicResource RestartFill}"/>
  </Style>

  <Style x:Key="OptionChip" TargetType="CheckBox">
    <Setter Property="Height" Value="30"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Padding" Value="10,0,12,0"/>
    <Setter Property="Margin" Value="0,0,6,0"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                  CornerRadius="15" Padding="{TemplateBinding Padding}"
                  Height="{TemplateBinding Height}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource AccentBright}"/>
              <Setter Property="Background" Value="{DynamicResource AccentDim}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Loadscreen thumbnail. Art fills the tile; the label sits on a scrim so it
       stays readable over a bright screenshot. -->
  <Style x:Key="MapTile" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Width" Value="196"/>
    <Setter Property="Height" Value="118"/>
    <Setter Property="Margin" Value="0,0,10,10"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Clip" CornerRadius="4"
                    Background="{TemplateBinding Background}">
              <Grid local:RoundedClip.Radius="4">
                <Image Source="{Binding Art}" Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="LowQuality"/>
                <Border VerticalAlignment="Bottom" Height="46" Background="{DynamicResource TileFade}"/>
                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Bottom"
                           Margin="10,0,10,8" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           TextTrimming="CharacterEllipsis"/>
              </Grid>
            </Border>
            <Border x:Name="Sheen" CornerRadius="4" Opacity="0"
                    Background="{DynamicResource OverlayLight}"/>
            <Border x:Name="Ring" CornerRadius="4" BorderThickness="2"
                    BorderBrush="{DynamicResource Accent}" Opacity="0"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Sheen" Property="Opacity" Value="0.10"/>
            </Trigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
              <Setter TargetName="Ring" Property="Opacity" Value="1"/>
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FavoriteStar" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Width" Value="28"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsFavorite}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource AccentBright}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="FooterIcon" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Width" Value="26"/>
    <Setter Property="Height" Value="26"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0,0,6,0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- ============================ INPUTS ============================ -->

  <Style x:Key="BaseTextBox" TargetType="TextBox">
    <Setter Property="Height" Value="32"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CaretBrush" Value="{DynamicResource AccentBright}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd" CornerRadius="4"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <!-- The editor applies the control's Padding itself; a Padding
                 margin here would indent the text and caret twice. -->
            <ScrollViewer x:Name="PART_ContentHost"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          Focusable="False"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TextBox" BasedOn="{StaticResource BaseTextBox}"/>

  <Style x:Key="BasePasswordBox" TargetType="PasswordBox">
    <Setter Property="Height" Value="32"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CaretBrush" Value="{DynamicResource AccentBright}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border x:Name="Bd" CornerRadius="4"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <ScrollViewer x:Name="PART_ContentHost"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          Focusable="False"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="PasswordBox" BasedOn="{StaticResource BasePasswordBox}"/>

  <!-- Read-only log / body panes: no chrome, free height. -->
  <Style x:Key="PlainTextBox" TargetType="TextBox" BasedOn="{StaticResource BaseTextBox}">
    <Setter Property="Height" Value="Auto"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="VerticalContentAlignment" Value="Top"/>
  </Style>

  <!-- Command line for a log pane. Tag carries the empty-state hint. -->
  <Style x:Key="ConsoleInput" TargetType="TextBox" BasedOn="{StaticResource BaseTextBox}">
    <Setter Property="FontFamily" Value="Consolas"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="26,0,10,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd" CornerRadius="4"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <Grid>
              <TextBlock Text="&gt;" Margin="11,0,0,0" VerticalAlignment="Center"
                         FontFamily="Consolas" FontSize="13"
                         Foreground="{DynamicResource TextMuted}"/>
              <TextBlock x:Name="Hint" Visibility="Collapsed"
                         Text="{TemplateBinding Tag}"
                         Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                         FontFamily="Consolas" FontSize="13"
                         Foreground="{DynamicResource TextMuted}"/>
              <ScrollViewer x:Name="PART_ContentHost"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Focusable="False"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Text" Value=""/>
                <Condition Property="IsKeyboardFocusWithin" Value="False"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
            </MultiTrigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="BaseCheckBox" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Box" Width="14" Height="14" CornerRadius="3"
                    VerticalAlignment="Center"
                    Background="{DynamicResource FieldBg}"
                    BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"/>
            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"
                              RecognizesAccessKey="True"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Log pane: selectable, never wraps (a wrapped console misreads), and the
       document width is fixed so layout does not rescan on every append. -->
  <Style x:Key="ConsolePane" TargetType="RichTextBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinHeight" Value="80"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
    <Setter Property="Foreground" Value="{DynamicResource TextCode}"/>
    <Setter Property="FontFamily" Value="Consolas"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
    <Setter Property="SelectionOpacity" Value="0.35"/>
    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
    <Setter Property="SpellCheck.IsEnabled" Value="False"/>
    <Setter Property="AutoWordSelection" Value="False"/>
    <Setter Property="Block.LineHeight" Value="14"/>
  </Style>

  <Style TargetType="CheckBox" BasedOn="{StaticResource BaseCheckBox}"/>

  <Style x:Key="QuietCheck" TargetType="CheckBox" BasedOn="{StaticResource BaseCheckBox}">
    <Setter Property="Margin" Value="0,0,14,0"/>
    <Setter Property="FontSize" Value="12.5"/>
  </Style>

  <Style TargetType="ProgressBar">
    <Setter Property="Background" Value="{DynamicResource AccentTrack}"/>
    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <Border CornerRadius="4" Background="{TemplateBinding Background}"/>
            <Border x:Name="PART_Track"/>
            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                    CornerRadius="4" Background="{TemplateBinding Foreground}"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ COMBO ============================ -->

  <Style x:Key="DarkCombo" TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="ToggleButton"
                          Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Grid>
                    <Border x:Name="Chrome" CornerRadius="4"
                            Background="{DynamicResource FieldBg}"
                            BorderBrush="Transparent" BorderThickness="1"/>
                    <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                          Margin="0,0,11,0" Data="M 0 0 L 4.5 4.5 L 9 0"
                          Stroke="{DynamicResource AccentBright}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter Margin="10,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                              IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
            <TextBox x:Name="PART_EditableTextBox"
                     Style="{StaticResource PlainTextBox}"
                     Margin="10,0,30,0" Visibility="Hidden"
                     VerticalAlignment="Center" Focusable="True"/>
            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Border MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}"
                      Margin="0,4,0,0" CornerRadius="4" Padding="4"
                      Background="{DynamicResource SurfaceRaised}"
                      BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1">
                <ScrollViewer>
                  <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEditable" Value="True">
              <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
              <Setter Property="IsTabStop" Value="False"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="ComboBoxItem">
          <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="Padding" Value="10,7"/>
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ComboBoxItem">
                <Border x:Name="Bd" CornerRadius="4"
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}">
                  <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentDim}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentBright}"/>
                  </Trigger>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentDim}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentBright}"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- One template for both roles: the arrow and the popup appear only when the
       item actually has children, so leaves and group headers share a style. -->
  <Style x:Key="DarkMenuItem" TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Grid>
            <Border x:Name="Bd" CornerRadius="4"
                    Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}">
              <DockPanel LastChildFill="True">
                <Path x:Name="Check" DockPanel.Dock="Left"
                      Margin="0,0,8,0" VerticalAlignment="Center"
                      Visibility="Collapsed"
                      Data="M 0 4 L 3 7 L 8 0"
                      Stroke="{DynamicResource AccentBright}" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path x:Name="Arrow" DockPanel.Dock="Right"
                      Margin="14,0,2,0" VerticalAlignment="Center"
                      Visibility="Collapsed"
                      Data="M 0 0 L 4 4 L 0 8"
                      Stroke="{DynamicResource TextMuted}" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
              </DockPanel>
            </Border>
            <Popup x:Name="PART_Popup" Placement="Right"
                   HorizontalOffset="2" VerticalOffset="-6"
                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
              <Border CornerRadius="4" Padding="4"
                      Background="{DynamicResource SurfaceRaised}"
                      BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1">
                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="HasItems" Value="True">
              <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentDim}"/>
              <Setter Property="Foreground" Value="{DynamicResource AccentBright}"/>
              <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource AccentBright}"/>
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentDim}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Must be set on the Separator itself: DarkContextMenu hands its
       ItemContainerStyle to every child, and a MenuItem style on a Separator
       throws when the menu opens. -->
  <Style x:Key="DarkMenuSeparator" TargetType="Separator">
    <Setter Property="Margin" Value="6,4"/>
    <Setter Property="Height" Value="1"/>
    <Setter Property="Background" Value="{DynamicResource BorderSoft}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Background="{TemplateBinding Background}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DarkContextMenu" TargetType="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="4"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource DarkMenuItem}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border CornerRadius="4"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}">
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DarkListBox" TargetType="ListBox">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <Border Background="{TemplateBinding Background}">
            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
              <ItemsPresenter/>
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="ListBoxItem">
          <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="Padding" Value="10,8"/>
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Bd" CornerRadius="4" Margin="0,0,0,4"
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}">
                  <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentDim}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentBright}"/>
                  </Trigger>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentDim}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentBright}"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ SCROLLBARS ============================ -->

  <Style x:Key="QuietScrollPage" TargetType="RepeatButton">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="QuietScrollThumb" TargetType="Thumb">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Pill" Background="{DynamicResource ScrollThumb}" CornerRadius="4" Margin="1,0"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Pill" Property="Background" Value="{DynamicResource ScrollThumbHover}"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Accent}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <ControlTemplate x:Key="QuietVerticalScrollBar" TargetType="ScrollBar">
    <Grid Background="Transparent" Width="10">
      <Border Background="{DynamicResource SurfaceSunken}" CornerRadius="4" Margin="2,6" Opacity="0.55"/>
      <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2,6">
        <Track.DecreaseRepeatButton>
          <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource QuietScrollPage}"/>
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource QuietScrollThumb}"/>
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource QuietScrollPage}"/>
        </Track.IncreaseRepeatButton>
      </Track>
    </Grid>
  </ControlTemplate>

  <ControlTemplate x:Key="QuietHorizontalScrollBar" TargetType="ScrollBar">
    <Grid Background="Transparent" Height="10">
      <Border Background="{DynamicResource SurfaceSunken}" CornerRadius="4" Margin="6,2" Opacity="0.55"/>
      <Track x:Name="PART_Track" Margin="6,2">
        <Track.DecreaseRepeatButton>
          <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource QuietScrollPage}"/>
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource QuietScrollThumb}"/>
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource QuietScrollPage}"/>
        </Track.IncreaseRepeatButton>
      </Track>
    </Grid>
  </ControlTemplate>

  <Style TargetType="ScrollBar">
    <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
    <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
    <Setter Property="Background" Value="Transparent"/>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Vertical">
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template" Value="{StaticResource QuietVerticalScrollBar}"/>
      </Trigger>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Height" Value="10"/>
        <Setter Property="MinHeight" Value="10"/>
        <Setter Property="Template" Value="{StaticResource QuietHorizontalScrollBar}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ============================ MISC ============================ -->

  <Style TargetType="Hyperlink">
    <Setter Property="Foreground" Value="{DynamicResource AccentBright}"/>
    <Setter Property="TextDecorations" Value="{x:Null}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="TextDecorations" Value="Underline"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="MaxWidth" Value="360"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border CornerRadius="4" Padding="10,7"
                  MaxWidth="{TemplateBinding MaxWidth}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                       TextWrapping="Wrap"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ MODS ============================ -->

  <Style x:Key="FilterTab" TargetType="Button" BasedOn="{StaticResource TabButton}">
    <Setter Property="Height" Value="30"/>
    <Setter Property="Margin" Value="0,0,18,0"/>
    <Setter Property="FontSize" Value="12.5"/>
  </Style>

  <Style x:Key="FilterTabOn" TargetType="Button" BasedOn="{StaticResource FilterTab}">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- Plain text action: no fill, no outline. -->
  <Style x:Key="TextButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.38"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TextButtonAccent" TargetType="Button" BasedOn="{StaticResource TextButton}">
    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="TextButtonDanger" TargetType="Button" BasedOn="{StaticResource TextButton}">
    <Setter Property="Foreground" Value="{DynamicResource DangerFg}"/>
  </Style>

  <!-- Square solid fills for the one main action per surface. -->
  <Style x:Key="FlatFillButton" TargetType="Button">
    <Setter Property="Height" Value="34"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    <Setter Property="Background" Value="{DynamicResource PrimaryFill}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border Background="{TemplateBinding Background}"/>
            <Border x:Name="Sheen" Opacity="0" Background="{DynamicResource OverlayLight}"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Sheen" Property="Opacity" Value="0.08"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.38"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FlatUpdateButton" TargetType="Button" BasedOn="{StaticResource FlatFillButton}">
    <Setter Property="Foreground" Value="{DynamicResource UpdateText}"/>
    <Setter Property="Background" Value="{DynamicResource UpdateFill}"/>
  </Style>

  <Style x:Key="FlatQuietButton" TargetType="Button" BasedOn="{StaticResource FlatFillButton}">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="FlatBar" TargetType="ProgressBar">
    <Setter Property="Height" Value="4"/>
    <Setter Property="Minimum" Value="0"/>
    <Setter Property="Maximum" Value="100"/>
    <Setter Property="Background" Value="{DynamicResource BarTrack}"/>
    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <Border Background="{TemplateBinding Background}"/>
            <Border x:Name="PART_Track"/>
            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Catalog card: flat; the selected card gets a lighter ground and an accent edge. -->
  <Style x:Key="ModCard" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="0,0,0,2"/>
            <Border x:Name="Sheen" Opacity="0" Background="{DynamicResource OverlayLight}"/>
            <ContentPresenter Margin="0,0,0,2"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Sheen" Property="Opacity" Value="0.04"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Square on/off switch. -->
  <Style x:Key="FlatSwitch" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Width" Value="40"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Border x:Name="Track" Background="{DynamicResource BorderStrong}"/>
            <Border x:Name="Knob" Width="16" Height="16" Margin="3,0" HorizontalAlignment="Left"
                    Background="{DynamicResource TextPrimary}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource PrimaryFill}"/>
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.38"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>


  <!-- ======================= SHELL LAYOUT ======================= -->

  <Style x:Key="ToggleSwitch" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Width="38" Height="22" Background="Transparent">
            <Border x:Name="Track" CornerRadius="11" Background="{DynamicResource BorderStrong}"/>
            <Ellipse x:Name="Knob" Width="16" Height="16" HorizontalAlignment="Left" Margin="3,0,0,0"
                     Fill="{DynamicResource OverlayLight}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource PrimaryFill}"/>
              <Setter TargetName="Knob" Property="Margin" Value="19,0,0,0"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBright}"/>
              <Setter TargetName="Track" Property="BorderThickness" Value="1"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SettingCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="18,6"/>
    <Setter Property="Margin" Value="0,0,0,14"/>
  </Style>

  <Style x:Key="SettingRow" TargetType="DockPanel">
    <Setter Property="MinHeight" Value="48"/>
    <Setter Property="LastChildFill" Value="True"/>
  </Style>

  <Style x:Key="SettingRule" TargetType="Border">
    <Setter Property="Height" Value="0"/>
  </Style>

  <Style x:Key="SettingLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>

  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="18"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
  </Style>

  <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Height" Value="38"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="Margin" Value="0,0,0,2"/>
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
  </Style>

  <Style x:Key="RailButtonOn" TargetType="Button" BasedOn="{StaticResource RailButton}">
    <Setter Property="Background" Value="{DynamicResource AccentDim}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Height" Value="44"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
  </Style>

  <Style x:Key="PillDivider" TargetType="Border">
    <Setter Property="Width" Value="1"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="Margin" Value="10,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Background" Value="{DynamicResource BorderStrong}"/>
  </Style>

  <Style x:Key="PillFlag" TargetType="TextBlock">
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBright}"/>
  </Style>

  <Style x:Key="Chip" TargetType="Border">
    <Setter Property="Margin" Value="10,0,0,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="ChipText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBright}"/>
  </Style>

  <Style x:Key="SignalDot" TargetType="Ellipse">
    <Setter Property="Width" Value="6"/>
    <Setter Property="Height" Value="6"/>
    <Setter Property="Margin" Value="0,1,5,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Fill" Value="{DynamicResource Accent}"/>
  </Style>

  <Style x:Key="SegmentBar" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SurfaceSunken}"/>
    <Setter Property="CornerRadius" Value="7"/>
    <Setter Property="Padding" Value="2"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="HeaderSeasonSegment" TargetType="Button" BasedOn="{StaticResource RingSegment}">
    <Setter Property="Height" Value="32"/>
    <Setter Property="MinWidth" Value="96"/>
    <Setter Property="Padding" Value="14,0"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>

  <Style x:Key="TickSegment" TargetType="Button" BasedOn="{StaticResource RingSegment}">
    <Setter Property="MinWidth" Value="52"/>
    <Setter Property="Height" Value="26"/>
  </Style>

  <Style x:Key="PopupCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="16,8"/>
    <Setter Property="Margin" Value="16"/>
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.55" Color="#000000"/>
      </Setter.Value>
    </Setter>
  </Style>

  <BitmapImage x:Key="SeasonArtS21" UriSource="pack://application:,,,/Assets/season_s21.jpg" DecodePixelWidth="640"/>
  <BitmapImage x:Key="SeasonArtS30" UriSource="pack://application:,,,/Assets/season_s30.jpg" DecodePixelWidth="640"/>

  <LinearGradientBrush x:Key="SeasonCardShade" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#00000000" Offset="0.25"/>
    <GradientStop Color="#E6000000" Offset="1"/>
  </LinearGradientBrush>

  <!-- Tag carries the art. The chosen season is lit with a bar along its foot; the other sits back. -->
  <Style x:Key="SeasonCard" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Height" Value="124"/>
    <Setter Property="FontSize" Value="17"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="#FFFFFFFF"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid local:RoundedClip.Radius="12">
            <Image Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                   Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <Border Background="{DynamicResource SeasonCardShade}"/>
            <Border x:Name="Dim" Background="#000000" Opacity="0.55"/>
            <ContentPresenter VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="14,0,14,14"/>
            <Border x:Name="Spot" Height="4" VerticalAlignment="Bottom" Opacity="0"
                    Background="{DynamicResource Accent}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Dim" Property="Opacity" Value="0.25"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Dim" Property="Opacity" Value="0"/>
              <Setter TargetName="Spot" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="MapStripTile" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="Transparent">
            <Border x:Name="Art" CornerRadius="8" Opacity="0.62" Background="{DynamicResource SurfaceSunken}"
                    RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform>
                <ScaleTransform x:Name="ArtScale"/>
              </Border.RenderTransform>
              <Grid local:RoundedClip.Radius="8">
                <Image Source="{Binding Art}" Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="LowQuality"/>
                <Border VerticalAlignment="Bottom" Height="46" Background="{DynamicResource TileFade}"/>
              </Grid>
            </Border>
            <TextBlock x:Name="Label" Text="{Binding DisplayName}" VerticalAlignment="Bottom"
                       Margin="8,0,8,7" MaxHeight="32" FontSize="12" LineHeight="15"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" TextAlignment="Center"
                       IsHitTestVisible="False" Foreground="{DynamicResource TextPrimary}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ArtScale" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.12"/>
                    <DoubleAnimation Storyboard.TargetName="ArtScale" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.12"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ArtScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14"/>
                    <DoubleAnimation Storyboard.TargetName="ArtScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
              <Setter TargetName="Art" Property="Opacity" Value="1"/>
            </Trigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
              <Setter TargetName="Art" Property="Opacity" Value="1"/>
              <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ModSegOff" TargetType="Button" BasedOn="{StaticResource RingSegment}">
    <Setter Property="Height" Value="24"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding PolicyIndex}" Value="0">
        <Setter Property="Background" Value="{DynamicResource BorderStrong}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="ModSegRequired" TargetType="Button" BasedOn="{StaticResource RingSegment}">
    <Setter Property="Height" Value="24"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding PolicyIndex}" Value="1">
        <Setter Property="Background" Value="{DynamicResource PrimaryFill}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="ModSegAllowed" TargetType="Button" BasedOn="{StaticResource RingSegment}">
    <Setter Property="Height" Value="24"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding PolicyIndex}" Value="2">
        <Setter Property="Background" Value="{DynamicResource PrimaryFill}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>

<Window x:Class="R5Flowstate.Shell.HostSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:R5Flowstate.Shell"
        Title="{loc:T host_settings_title}"
        Icon="Assets/app.ico"
        Width="640" SizeToContent="Height"
        MinWidth="520" MaxHeight="820"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource WindowBg}" Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <DockPanel Margin="22,18,22,16">
    <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0" LastChildFill="False">
      <Button DockPanel.Dock="Right" Content="{loc:T close}"
              MinWidth="120" Height="36" IsDefault="True" IsCancel="True"
              Style="{StaticResource AccentButton}" Click="OnClose"/>
      <Button DockPanel.Dock="Left" Content="{loc:T host_settings_reset}"
              MinWidth="120" Height="36"
              Style="{StaticResource GhostButton}" Click="OnReset"/>
    </DockPanel>

    <StackPanel DockPanel.Dock="Top">
      <TextBlock x:Name="TxtMode" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
      <TextBlock FontSize="13" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                 Text="{loc:T host_settings_hint}" Margin="0,0,0,14"/>

      <Border Style="{StaticResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="{loc:T host_presets}" Style="{StaticResource SectionLabel}"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="CmbPreset" Grid.Column="0" Height="32" Margin="0,0,8,0"
                      Style="{StaticResource DarkCombo}"
                      IsEditable="True" IsTextSearchEnabled="False"
                      ToolTip="{loc:T tip_host_preset_name}"
                      SelectionChanged="OnPresetSelected"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button Content="{loc:T host_preset_save}" Height="32" Padding="12,0" Margin="0,0,6,0"
                      Style="{StaticResource AccentButton}" Click="OnSavePreset"/>
              <Button Content="{loc:T host_preset_delete}" Height="32" Padding="12,0" Margin="0,0,6,0"
                      Style="{StaticResource GhostButton}" Click="OnDeletePreset"/>
              <Button Content="{loc:T host_preset_import}" Height="32" Padding="12,0" Margin="0,0,6,0"
                      Style="{StaticResource GhostButton}" Click="OnImportPreset"/>
              <Button Content="{loc:T host_preset_export}" Height="32" Padding="12,0"
                      Style="{StaticResource GhostButton}" Click="OnExportPreset"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom">
      <TextBlock Text="{loc:T host_settings_args}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{loc:T copy}" Height="30" Padding="12,0" Margin="8,0,0,0"
                VerticalAlignment="Top"
                Style="{StaticResource GhostButton}" Click="OnCopyArgs"/>
        <TextBox x:Name="TxtArgs" IsReadOnly="True" TextWrapping="Wrap"
                 Style="{StaticResource PlainTextBox}"
                 FontFamily="Consolas" FontSize="12"
                 Foreground="{StaticResource TextCode}"
                 MinHeight="40" MaxHeight="120"
                 VerticalScrollBarVisibility="Auto"/>
      </DockPanel>
      <TextBlock x:Name="TxtStatus" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                 Foreground="{StaticResource TextSecondary}"/>
    </StackPanel>

    <Border Style="{StaticResource Card}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="GridSettings">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
        </Grid>
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>

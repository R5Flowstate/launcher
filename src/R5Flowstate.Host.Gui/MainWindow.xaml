<Window x:Class="R5Flowstate.HostGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="R5Flowstate Server" Width="1180" Height="780" MinWidth="980" MinHeight="620"
        Background="{StaticResource WindowBg}" Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded" Closing="OnClosing">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Install bar -->
    <Border Grid.Row="0" Style="{StaticResource Card}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Image Source="Assets/icon-mark.png" Width="28" Height="28" Margin="0,0,14,0" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="SERVER FOLDER" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
          <TextBox x:Name="TxtPath" LostFocus="OnPathCommitted" KeyDown="OnPathKeyDown"/>
        </StackPanel>
        <Button Grid.Column="2" Content="Browse" Style="{StaticResource GhostButton}" Margin="10,18,0,0" Click="OnBrowse"/>
        <StackPanel Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="RING" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
          <ComboBox x:Name="CmbRing" Width="120" Style="{StaticResource DarkCombo}" SelectionChanged="OnRingChanged">
            <ComboBoxItem Content="Live"/>
            <ComboBoxItem Content="Playtest"/>
          </ComboBox>
        </StackPanel>
        <Button x:Name="BtnCheck" Grid.Column="4" Content="Check" Style="{StaticResource GhostButton}" Margin="12,18,0,0" Click="OnCheck"/>
        <Button x:Name="BtnInstall" Grid.Column="5" Content="Install" Style="{StaticResource PrimaryButton}" Margin="10,18,0,0" MinWidth="120" Click="OnInstall"/>
      </Grid>
    </Border>

    <!-- Status line -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="TxtVersions" Text="Not installed" Foreground="{StaticResource TextSecondary}"/>
          <TextBlock x:Name="TxtStatus" Text="" Style="{StaticResource MonoNote}" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <ProgressBar x:Name="BarProgress" Height="6" Minimum="0" Maximum="100" Value="0"/>
          <TextBlock x:Name="TxtUpdateBanner" Margin="0,8,0,0" FontWeight="SemiBold" TextWrapping="Wrap"
                     Foreground="{StaticResource UpdateFill}" Visibility="Collapsed"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Main -->
    <Grid Grid.Row="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
        <Button x:Name="TabServers" Content="Servers" Style="{StaticResource TabButtonOn}" Click="OnTabServers"/>
        <Button x:Name="TabMods" Content="Mods" Style="{StaticResource TabButton}" Margin="6,0,0,0" Click="OnTabMods"/>
      </StackPanel>

      <!-- Servers page -->
      <Grid x:Name="PageServers" Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="240"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="380"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Margin="0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="INSTANCES" Style="{StaticResource SectionLabel}"/>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtNewInstance" ToolTip="a-z 0-9 _ - (up to 24)"/>
                <Button Grid.Column="1" Content="Add" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="OnAddInstance"/>
              </Grid>
              <Button Content="Remove" Style="{StaticResource DangerButtonSmall}" Margin="0,8,0,0" Click="OnRemoveInstance"/>
              <Button x:Name="BtnStartAll" Content="Start all" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0" Click="OnStartAll"/>
              <Button x:Name="BtnStopAll" Content="Stop all" Style="{StaticResource GhostButton}" Margin="0,6,0,0" Click="OnStopAll"/>
            </StackPanel>
            <ListBox x:Name="LstInstances" Style="{StaticResource DarkListBox}" SelectionChanged="OnInstanceSelected"/>
          </DockPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PanelInstance" IsEnabled="False">
              <TextBlock x:Name="TxtInstanceTitle" Text="SETTINGS" Style="{StaticResource SectionLabel}"/>
              <TextBlock Text="Server name" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="TxtHostname" Margin="0,0,0,10"/>
              <TextBlock Text="Description" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="TxtDescription" Margin="0,0,0,10"/>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Port" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="TxtPort"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Visibility" Style="{StaticResource FieldLabel}"/>
                  <ComboBox x:Name="CmbVisibility" Style="{StaticResource DarkCombo}">
                    <ComboBoxItem Content="Public"/>
                    <ComboBoxItem Content="Hidden"/>
                    <ComboBoxItem Content="Offline"/>
                  </ComboBox>
                </StackPanel>
              </Grid>
              <TextBlock Text="Playlist" Style="{StaticResource FieldLabel}"/>
              <ComboBox x:Name="CmbPlaylist" Style="{StaticResource DarkCombo}" Margin="0,0,0,10"
                        SelectionChanged="OnPlaylistChanged"/>
              <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Map" Style="{StaticResource FieldLabel}"/>
                <CheckBox x:Name="ChkAllMaps" Grid.Column="1" Content="All maps" Style="{StaticResource QuietCheck}"
                          Checked="OnAllMapsChanged" Unchecked="OnAllMapsChanged"
                          ToolTip="Offer every map in the install, not only the playlist's"/>
              </Grid>
              <ComboBox x:Name="CmbMap" Style="{StaticResource DarkCombo}" Margin="0,0,0,10"/>
              <TextBlock Text="SERVER SETTINGS" Style="{StaticResource SectionLabel}" Margin="0,6,0,6"/>
              <TextBlock x:Name="TxtNoSettings" Text="This playlist has no server settings." Style="{StaticResource MonoNote}" Margin="0,0,0,10"/>
              <StackPanel x:Name="PanelSettings" Margin="0,0,0,6"/>
              <Button x:Name="BtnResetSettings" Content="Reset to playlist defaults" Style="{StaticResource GhostButton}"
                      HorizontalAlignment="Left" Margin="0,0,0,14" Click="OnResetSettings"/>
              <TextBlock Text="Join password (empty = none)" Style="{StaticResource FieldLabel}"/>
              <PasswordBox x:Name="PwdJoin" Margin="0,0,0,10"/>
              <TextBlock Text="RCON password" Style="{StaticResource FieldLabel}"/>
              <PasswordBox x:Name="PwdRcon" Margin="0,0,0,10"/>
              <TextBlock Text="Stats host key (leaderboards)" Style="{StaticResource FieldLabel}"/>
              <PasswordBox x:Name="PwdStats" Margin="0,0,0,10"/>
              <TextBlock Text="Extra launch arguments" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="TxtExtra" Margin="0,0,0,10" FontFamily="Consolas"/>
              <CheckBox x:Name="ChkAutoRestart" Content="Restart after a crash" Margin="0,0,0,14"/>
              <Button Content="Save" Style="{StaticResource PrimaryButton}" Click="OnSaveInstance"/>
              <TextBlock Text="Saved changes apply on the next start." Style="{StaticResource MonoNote}" Margin="0,8,0,0"/>
              <TextBlock Text="LAUNCH LINE" Style="{StaticResource SectionLabel}" Margin="0,14,0,4"/>
              <TextBox x:Name="TxtArgs" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <Border Grid.Column="4" Style="{StaticResource Card}" Margin="0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TxtConsoleTitle" Text="CONSOLE" Style="{StaticResource SectionLabel}" Margin="0"/>
                <TextBlock x:Name="TxtRunState" Text="stopped" Style="{StaticResource MonoNote}"/>
              </StackPanel>
              <Button x:Name="BtnStart" Grid.Column="1" Content="Start" Style="{StaticResource PrimaryButton}" Click="OnStart"/>
              <Button x:Name="BtnRestart" Grid.Column="2" Content="Restart" Style="{StaticResource RestartButtonSmall}" Margin="6,0,0,0" Click="OnRestart"/>
              <Button x:Name="BtnStop" Grid.Column="3" Content="Stop" Style="{StaticResource DangerButtonSmall}" Margin="6,0,0,0" Click="OnStop"/>
            </Grid>
            <TextBox x:Name="TxtConsole" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas" FontSize="11.5"
                     TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top" Background="{StaticResource SurfaceSunken}"/>
            <Grid Grid.Row="2" Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="TxtCommand" FontFamily="Consolas" KeyDown="OnCommandKeyDown"
                       ToolTip="Console command for this server (say, changelevel, kick ...)"/>
              <Button Grid.Column="1" Content="Send" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="OnSendCommand"/>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <!-- Mods page -->
      <Grid x:Name="PageMods" Grid.Row="1" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Margin="0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="INSTALLED" Style="{StaticResource SectionLabel}"/>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
              <Button Content="Remove" Style="{StaticResource DangerButtonSmall}" Click="OnModRemove"/>
              <Button Content="Required / optional" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="OnModTogglePolicy"/>
              <Button Content="Update all" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="OnModUpdateAll"/>
              <Button Content="Sync to lock" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="OnModSync"
                      ToolTip="Reinstall exactly the versions pinned in mods.lock.json"/>
            </StackPanel>
            <ListBox x:Name="LstInstalledMods" Style="{StaticResource DarkListBox}" FontFamily="Consolas"/>
          </DockPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="THUNDERSTORE" Style="{StaticResource SectionLabel}"/>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="TxtModSearch" KeyDown="OnModSearchKeyDown" ToolTip="Search by name, author or description"/>
              <Button Grid.Column="1" Content="Search" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="OnModSearch"/>
            </Grid>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
              <StackPanel Orientation="Horizontal">
                <Button Content="Install" Style="{StaticResource PrimaryButton}" Click="OnModInstall"/>
                <CheckBox x:Name="ChkModOptional" Content="Optional for players" Margin="12,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtProfileCode" ToolTip="Thunderstore / launcher profile code"/>
                <Button Grid.Column="1" Content="Import profile" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="OnModImport"/>
              </Grid>
            </StackPanel>
            <TextBlock x:Name="TxtModDetail" DockPanel.Dock="Bottom" Style="{StaticResource MonoNote}" Margin="0,8,0,0"
                       TextWrapping="Wrap" MaxHeight="80"/>
            <ListBox x:Name="LstCatalog" Style="{StaticResource DarkListBox}" SelectionChanged="OnCatalogSelected"/>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
